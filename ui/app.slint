export struct LogEntryData {
    id: string,
    time: string,
    method: string,
    path: string,
    model: string,
    status: int,
    tokens: int,
    latency_ms: int,
}

export struct AccountData {
    id: string,
    name: string,
    provider: string,
    base_url: string,
    api_key_masked: string,
    fingerprint: string,
    is_active: bool,
}

component NavButton inherits Rectangle {
    in property <string> text;
    in property <bool> is_active: false;
    callback clicked;

    height: 36px;
    border-radius: 8px;
    background: root.is_active ? #ffffff : (touch.has-hover ? #22242e : transparent);
    animate background { duration: 120ms; }

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        font-size: 13px;
        font-weight: root.is_active ? 700 : 500;
        color: root.is_active ? #0c0d12 : (touch.has-hover ? #ffffff : #9499ad);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> is_primary: true;
    in property <bool> is_danger: false;
    callback clicked;

    height: 34px;
    border-radius: 8px;
    background: root.is_danger 
        ? (touch.pressed ? #b33939 : (touch.has-hover ? #e74c3c : #962d2d))
        : (root.is_primary 
            ? (touch.pressed ? #d8d8d8 : (touch.has-hover ? #ffffff : #eeeeee))
            : (touch.pressed ? #191b22 : (touch.has-hover ? #2c303c : #20232c)));
    border-width: root.is_primary ? 0px : 1px;
    border-color: #353947;
    animate background { duration: 100ms; }

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        font-size: 12px;
        font-weight: 700;
        color: root.is_danger ? #ffffff : (root.is_primary ? #0c0d12 : #e0e3ed);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component StatCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> subtext;

    border-radius: 10px;
    background: #14161e;
    border-width: 1px;
    border-color: #242735;

    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        Text {
            text: root.title;
            font-size: 11px;
            font-weight: 600;
            color: #797f94;
        }
        Text {
            text: root.value;
            font-size: 20px;
            font-weight: 800;
            color: #ffffff;
        }
        Text {
            text: root.subtext;
            font-size: 10px;
            color: #9ea4b8;
        }
    }
}

export component MainWindow inherits Window {
    title: "Aroxy — Minimalist AI Protocol Proxy";
    min-width: 820px;
    min-height: 560px;
    preferred-width: 900px;
    preferred-height: 620px;
    background: #0c0d12;

    in-out property <int> active_tab: 0;
    in-out property <bool> proxy_running: false;
    in-out property <int> proxy_port: 8045;
    in-out property <string> active_model: "claude-3-7-sonnet";
    in-out property <string> total_requests: "0";
    in-out property <string> total_tokens: "0";
    in-out property <string> avg_latency: "0 ms";

    in-out property <[LogEntryData]> log_entries: [];
    in-out property <[AccountData]> accounts: [];

    in-out property <string> new_acc_name: "";
    in-out property <string> new_acc_key: "";
    in-out property <string> new_acc_url: "https://api.anthropic.com";
    in-out property <string> new_acc_fp: "Claude Code 2.x";

    callback toggle_proxy();
    callback clear_logs();
    callback add_account();
    callback delete_account(string);
    callback activate_account(string);

    HorizontalLayout {
        // Left Navigation Sidebar
        Rectangle {
            width: 180px;
            background: #11131a;
            border-width: 0px;
            border-color: #1e212b;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // Logo Area
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: #ffffff;
                        Text {
                            text: "A";
                            color: #0c0d12;
                            font-size: 16px;
                            font-weight: 900;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "AROXY";
                            font-size: 14px;
                            font-weight: 800;
                            color: #ffffff;
                            letter-spacing: 1px;
                        }
                        Text {
                            text: "v0.1.0 • Core";
                            font-size: 10px;
                            color: #6d7285;
                        }
                    }
                }

                Rectangle { height: 12px; }

                // Navigation Items
                NavButton {
                    text: "Dashboard";
                    is_active: root.active_tab == 0;
                    clicked => { root.active_tab = 0; }
                }
                NavButton {
                    text: "Accounts & FP";
                    is_active: root.active_tab == 1;
                    clicked => { root.active_tab = 1; }
                }
                NavButton {
                    text: "Live Logs";
                    is_active: root.active_tab == 2;
                    clicked => { root.active_tab = 2; }
                }
                NavButton {
                    text: "Settings";
                    is_active: root.active_tab == 3;
                    clicked => { root.active_tab = 3; }
                }

                // Spacer
                Rectangle { }

                // Proxy Quick Status Pill
                Rectangle {
                    height: 38px;
                    border-radius: 8px;
                    background: root.proxy_running ? #14281f : #221818;
                    border-width: 1px;
                    border-color: root.proxy_running ? #255a40 : #522727;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: center;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: root.proxy_running ? #3dd68c : #eb5757;
                        }
                        Text {
                            text: root.proxy_running ? "RUNNING :8045" : "OFFLINE";
                            font-size: 11px;
                            font-weight: 700;
                            color: root.proxy_running ? #3dd68c : #eb5757;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Main Content Area
        VerticalLayout {
            padding: 24px;
            spacing: 20px;

            // Header Bar
            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: root.active_tab == 0 ? "Dashboard & Emulation"
                            : root.active_tab == 1 ? "Upstream Accounts & Fingerprints"
                            : root.active_tab == 2 ? "Real-time Traffic & Stream Inspector"
                            : "System Configuration";
                        font-size: 20px;
                        font-weight: 800;
                        color: #ffffff;
                    }
                    Text {
                        text: root.active_tab == 0 ? "Local OpenAI v1 / Claude / Gemini endpoint emulation"
                            : root.active_tab == 1 ? "Manage provider keys and anti-detection client signatures"
                            : root.active_tab == 2 ? "High-performance streaming logs with zero-lock buffering"
                            : "Network, autostart, and tray daemon settings";
                        font-size: 12px;
                        color: #797f94;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    ActionButton {
                        text: root.proxy_running ? "STOP PROXY" : "START PROXY";
                        is_primary: !root.proxy_running;
                        is_danger: root.proxy_running;
                        clicked => { root.toggle_proxy(); }
                    }
                }
            }

            // Tab 0: Dashboard
            if root.active_tab == 0: VerticalLayout {
                spacing: 16px;

                HorizontalLayout {
                    spacing: 14px;
                    StatCard {
                        title: "TOTAL REQUESTS";
                        value: root.total_requests;
                        subtext: "All incoming API calls";
                    }
                    StatCard {
                        title: "PROCESSED TOKENS";
                        value: root.total_tokens;
                        subtext: "Prompt + Output + Thinking";
                    }
                    StatCard {
                        title: "AVG LATENCY";
                        value: root.avg_latency;
                        subtext: "Time to first token (TTFT)";
                    }
                    StatCard {
                        title: "LOCAL ENDPOINT";
                        value: "127.0.0.1:" + root.proxy_port;
                        subtext: "/v1/chat/completions";
                    }
                }

                Rectangle {
                    background: #14161e;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #242735;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 14px;
                        Text {
                            text: "Active Route & Compatible Clients";
                            font-size: 14px;
                            font-weight: 700;
                            color: #ffffff;
                        }
                        Text {
                            text: "Point your AI client (Claude Code, Cursor, OpenCode, Aider, LibreChat) to:";
                            font-size: 12px;
                            color: #9ea4b8;
                        }
                        Rectangle {
                            height: 38px;
                            border-radius: 8px;
                            background: #0d0e14;
                            border-width: 1px;
                            border-color: #2b2f3f;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: space-between;
                                Text {
                                    text: "http://127.0.0.1:8045/v1";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "OpenAI v1 / Claude / Gemini compliant";
                                    font-size: 11px;
                                    color: #5c6277;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Rectangle {
                                border-radius: 8px;
                                background: #1a1c26;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 4px;
                                    Text { text: "Claude Code CLI"; font-size: 12px; font-weight: 700; color: #ffffff; }
                                    Text { text: "ANTHROPIC_BASE_URL=http://localhost:8045"; font-size: 11px; color: #8a90a4; }
                                }
                            }
                            Rectangle {
                                border-radius: 8px;
                                background: #1a1c26;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 4px;
                                    Text { text: "OpenAI / Cursor / Aider"; font-size: 12px; font-weight: 700; color: #ffffff; }
                                    Text { text: "OPENAI_BASE_URL=http://localhost:8045/v1"; font-size: 11px; color: #8a90a4; }
                                }
                            }
                        }
                    }
                }
            }

            // Tab 1: Accounts & Fingerprints
            if root.active_tab == 1: VerticalLayout {
                spacing: 14px;

                Rectangle {
                    background: #14161e;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #242735;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text {
                            text: "Add Upstream Provider";
                            font-size: 14px;
                            font-weight: 700;
                            color: #ffffff;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            TextInput {
                                text <=> root.new_acc_name;
                                font-size: 12px;
                                color: #ffffff;
                                width: 140px;
                            }
                            TextInput {
                                text <=> root.new_acc_url;
                                font-size: 12px;
                                color: #ffffff;
                                width: 220px;
                            }
                            TextInput {
                                text <=> root.new_acc_key;
                                font-size: 12px;
                                color: #ffffff;
                                width: 180px;
                            }
                            ActionButton {
                                text: "+ Add";
                                is_primary: true;
                                clicked => { root.add_account(); }
                            }
                        }
                    }
                }

                // Accounts List
                Rectangle {
                    background: #14161e;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #242735;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: "Configured Accounts";
                            font-size: 13px;
                            font-weight: 700;
                            color: #797f94;
                        }

                        for acc in root.accounts: Rectangle {
                            height: 48px;
                            border-radius: 8px;
                            background: acc.is_active ? #1b212f : #101219;
                            border-width: 1px;
                            border-color: acc.is_active ? #38486b : #1d202b;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: center;
                                    Text {
                                        text: acc.name;
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: acc.base_url;
                                        font-size: 11px;
                                        color: #72788e;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "FP: " + acc.fingerprint;
                                        font-size: 10px;
                                        color: #4f556b;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;
                                    if !acc.is_active: ActionButton {
                                        text: "Set Active";
                                        is_primary: false;
                                        clicked => { root.activate_account(acc.id); }
                                    }
                                    ActionButton {
                                        text: "Delete";
                                        is_primary: false;
                                        is_danger: true;
                                        clicked => { root.delete_account(acc.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Tab 2: Logs
            if root.active_tab == 2: VerticalLayout {
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Recent Traffic (Last 100 requests)";
                        font-size: 13px;
                        font-weight: 700;
                        color: #797f94;
                        vertical-alignment: center;
                    }
                    ActionButton {
                        text: "Clear Logs";
                        is_primary: false;
                        clicked => { root.clear_logs(); }
                    }
                }

                Rectangle {
                    background: #14161e;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #242735;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;

                        // Table Header
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text { text: "TIME"; width: 80px; font-size: 10px; font-weight: 700; color: #52576b; }
                            Text { text: "METHOD"; width: 70px; font-size: 10px; font-weight: 700; color: #52576b; }
                            Text { text: "ENDPOINT"; width: 180px; font-size: 10px; font-weight: 700; color: #52576b; }
                            Text { text: "MODEL"; width: 160px; font-size: 10px; font-weight: 700; color: #52576b; }
                            Text { text: "STATUS"; width: 70px; font-size: 10px; font-weight: 700; color: #52576b; }
                            Text { text: "TOKENS"; width: 70px; font-size: 10px; font-weight: 700; color: #52576b; }
                            Text { text: "LATENCY"; width: 70px; font-size: 10px; font-weight: 700; color: #52576b; }
                        }

                        // Table Rows
                        for log in root.log_entries: Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: #0f1017;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text { text: log.time; width: 80px; font-size: 11px; color: #72788e; vertical-alignment: center; }
                                Text { text: log.method; width: 70px; font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                Text { text: log.path; width: 180px; font-size: 11px; color: #c4c7d5; vertical-alignment: center; }
                                Text { text: log.model; width: 160px; font-size: 11px; color: #8e95ad; vertical-alignment: center; }
                                Text {
                                    text: log.status == 200 ? "200 OK" : (log.status + "");
                                    width: 70px;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: log.status == 200 ? #3dd68c : #eb5757;
                                    vertical-alignment: center;
                                }
                                Text { text: log.tokens + ""; width: 70px; font-size: 11px; color: #9ea4b8; vertical-alignment: center; }
                                Text { text: log.latency_ms + "ms"; width: 70px; font-size: 11px; color: #72788e; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }

            // Tab 3: Settings
            if root.active_tab == 3: VerticalLayout {
                spacing: 14px;
                Rectangle {
                    background: #14161e;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #242735;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Text { text: "System & Network Preferences"; font-size: 14px; font-weight: 700; color: #ffffff; }
                        Text { text: "• System Tray Daemon: Minimize on close to run silently in background."; font-size: 12px; color: #9ea4b8; }
                        Text { text: "• Portable Config: Saves config next to binary in aroxy.json if portable mode is active."; font-size: 12px; color: #9ea4b8; }
                        Text { text: "• Zero Telemetry: Completely offline, no phone-home, no update trackers, no analytics."; font-size: 12px; color: #9ea4b8; }
                    }
                }
            }
        }
    }
}
