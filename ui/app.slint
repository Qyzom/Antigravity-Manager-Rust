import { ScrollView, LineEdit } from "std-widgets.slint";
import "./fonts/Unbounded.ttf";

export struct LogEntryData {
    id: string,
    time: string,
    method: string,
    path: string,
    model: string,
    status: int,
    tokens: int,
    latency_ms: int,
}

export struct AccountData {
    id: string,
    name: string,
    provider: string,
    base_url: string,
    api_key_masked: string,
    fingerprint: string,
    tier: string,
    quota_used: int,
    quota_limit: int,
    quota_percent: int,
    quota_reset: string,
    claude_gpt_percent: int,
    claude_gpt_reset: string,
    gemini_percent: int,
    gemini_reset: string,
    status: string,
    is_active: bool,
}

export struct ModelItemData {
    id: string,
    display_name: string,
    provider: string,
    tier: string,
    is_enabled: bool,
    supports_thinking: bool,
}

export struct I18nData {
    tab_dashboard: string,
    tab_accounts: string,
    tab_models: string,
    tab_proxy: string,
    tab_logs: string,
    tab_stats: string,
    tab_settings: string,

    btn_stop_proxy: string,
    btn_start_proxy: string,

    dash_title: string,
    dash_subtitle: string,
    stat_requests: string,
    stat_tokens: string,
    stat_latency: string,
    stat_accounts: string,
    stat_app_ram: string,
    stat_proxy_engine: string,
    quota_claude_title: string,
    quota_claude_desc: string,
    quota_gemini_title: string,
    quota_gemini_desc: string,

    acc_title: string,
    acc_subtitle: string,
    btn_login_oauth: string,
    btn_add_token: string,
    acc_placeholder: string,
    acc_pool_header: string,
    btn_update: string,
    btn_info: string,
    btn_delete: string,
    btn_enable: string,
    btn_disable: string,

    mod_title: string,
    mod_subtitle: string,
    group_reasoning_title: string,
    group_reasoning_desc: string,
    btn_test_dialog: string,

    test_dialog_title: string,
    test_prompt_label: string,
    test_timeout_label: string,
    test_max_tokens_label: string,
    test_stream_toggle: string,
    btn_send_test: string,
    btn_cancel_test: string,
    btn_close: string,

    proxy_title: string,
    proxy_subtitle: string,
    sec_network: string,
    sec_routing: string,
    sec_cache: string,
    sec_timeouts: string,
    lbl_port: string,
    lbl_host: string,
    lbl_timeout: string,
    lbl_heartbeat: string,
    lbl_failover: string,

    logs_title: string,
    logs_subtitle: string,
    btn_clear_logs: string,
    lbl_enable_logging: string,
    lbl_max_logs: string,

    stats_title: string,
    stats_subtitle: string,

    sett_title: string,
    sett_subtitle: string,
    sec_visual: string,
    lbl_language: string,
    lbl_quota_mode: string,
    opt_quota_percent: string,
    opt_quota_fraction: string,
    lbl_hide_brand: string,
    sec_system: string,
    lbl_tray: string,
    lbl_autostart: string,
    lbl_portable: string,
    btn_save_settings: string,
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> is_active: false;
    callback clicked;

    height: 38px;
    border-radius: 6px;
    background: root.is_active ? #27272a : (touch.has-hover ? #18181b : transparent);
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: start;

        Text {
            text: root.text;
            font-size: 13px;
            font-weight: root.is_active ? 700 : 500;
            color: root.is_active ? #fafafa : (touch.has-hover ? #e4e4e7 : #a1a1aa);
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> is_primary: true;
    in property <bool> is_danger: false;
    in property <bool> is_accent: false;
    in property <bool> is_disabled: false;
    callback clicked;

    height: 32px;
    border-radius: 6px;
    background: root.is_disabled
        ? #1c1c1f
        : (root.is_danger 
            ? (touch.pressed ? #5f1515 : (touch.has-hover ? #7f1d1d : #451010))
            : (root.is_accent
                ? (touch.pressed ? #e4e4e7 : (touch.has-hover ? #ffffff : #f4f4f5))
                : (root.is_primary 
                    ? (touch.pressed ? #323236 : (touch.has-hover ? #3f3f46 : #27272a))
                    : (touch.pressed ? #121214 : (touch.has-hover ? #202023 : #18181b)))));
    border-width: 1px;
    border-color: root.is_disabled ? #27272a : (root.is_danger ? #991b1b : (root.is_accent ? #ffffff : #3f3f46));
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 700;
            color: root.is_disabled ? #52525b : (root.is_danger ? #fca5a5 : (root.is_accent ? #09090b : #fafafa));
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.is_disabled ? default : pointer;
        clicked => {
            if !root.is_disabled {
                root.clicked();
            }
        }
    }
}

component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled;

    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? #f4f4f5 : #27272a;
    border-width: 1px;
    border-color: #3f3f46;
    animate background { duration: 150ms; }

    Rectangle {
        x: root.checked ? 22px : 3px;
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.checked ? #09090b : #71717a;
        animate x { duration: 150ms; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component StatCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> subtext;

    background: #18181b;
    border-radius: 8px;
    border-width: 1px;
    border-color: #27272a;

    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        alignment: space-between;

        Text {
            text: root.title;
            font-size: 10px;
            font-weight: 700;
            color: #71717a;
            letter-spacing: 0.5px;
        }
        Text {
            text: root.value;
            font-size: 20px;
            font-weight: 800;
            color: #fafafa;
        }
        Text {
            text: root.subtext;
            font-size: 10px;
            color: #a1a1aa;
        }
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <bool> is_green: false;
    in property <bool> is_amber: false;
    in property <bool> is_danger: false;

    height: 20px;
    border-radius: 4px;
    background: root.is_green ? #14281e : (root.is_amber ? #291c10 : (root.is_danger ? #291212 : #27272a));
    border-width: 1px;
    border-color: root.is_green ? #1e4a34 : (root.is_amber ? #4e3518 : (root.is_danger ? #4a1c1c : #3f3f46));

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 10px;
            font-weight: 700;
            color: root.is_green ? #4ade80 : (root.is_amber ? #fbbf24 : (root.is_danger ? #f87171 : #d4d4d8));
            vertical-alignment: center;
        }
    }
}

export component MainWindow inherits Window {
    title: "Aroxy";
    default-font-family: "Unbounded";
    min-width: 1080px;
    min-height: 720px;
    max-width: 1080px;
    max-height: 720px;
    background: #09090b;

    // Translations
    in-out property <I18nData> i18n;
    in-out property <int> current_language: 0; // 0: EN, 1: RU, 2: ZH

    // Navigation & Status
    in-out property <int> active_tab: 0;
    in-out property <bool> proxy_running: false;
    in-out property <int> proxy_port: 8045;
    in-out property <string> proxy_host: "127.0.0.1";
    in-out property <string> active_model: "claude-3-7-sonnet";
    in-out property <bool> expose_reasoning_variants: true;
    in-out property <bool> group_reasoning_clones: true;

    // Visual Preferences
    in-out property <string> quota_display_mode: "percent"; // "percent" or "fraction"
    in-out property <bool> hide_sidebar_brand: false;

    // Dashboard Overview Metrics
    in-out property <string> total_requests: "0";
    in-out property <string> total_tokens: "0";
    in-out property <string> avg_latency: "0 ms";
    in-out property <string> app_memory: "16.5 MB";
    in-out property <string> proxy_engine_status: "Tokio Lock-Free";
    in-out property <int> global_claude_percent: 100;
    in-out property <string> global_claude_label: "100% Available";
    in-out property <string> global_claude_reset: "in 4h 00m";
    in-out property <int> global_gemini_percent: 100;
    in-out property <string> global_gemini_label: "100% Available";
    in-out property <string> global_gemini_reset: "in 4h 00m";
    in-out property <int> healthy_accounts_count: 0;

    // Lists
    in-out property <[LogEntryData]> log_entries: [];
    in-out property <[AccountData]> accounts: [];
    in-out property <[ModelItemData]> models: [];

    // Account Form
    in-out property <string> new_acc_token: "";

    // Modal 1: Account Info Modal
    in-out property <bool> show_account_info: false;
    in-out property <string> info_account_name: "";
    in-out property <string> info_account_tier: "";
    in-out property <string> info_account_status: "ACTIVE";
    in-out property <string> info_account_claude: "";
    in-out property <string> info_account_gemini: "";
    in-out property <string> info_account_models: "";

    // Modal 2: Test Model Dialog
    in-out property <bool> show_test_dialog: false;
    in-out property <string> test_model_id: "claude-3-7-sonnet";
    in-out property <string> test_prompt: "What is 15 * 2? Answer in one word.";
    in-out property <string> test_timeout_secs: "60";
    in-out property <string> test_max_tokens: "2048";
    in-out property <string> test_temperature: "0.7";
    in-out property <bool> test_stream: true;
    in-out property <bool> test_running: false;
    in-out property <string> test_status: "Ready";
    in-out property <string> test_latency: "0 ms";
    in-out property <string> test_tokens: "0";
    in-out property <string> test_response: "";

    // Modal 3: Log Details Inspector
    in-out property <bool> show_log_modal: false;
    in-out property <string> modal_log_time: "";
    in-out property <string> modal_log_method: "";
    in-out property <string> modal_log_path: "";
    in-out property <string> modal_log_model: "";
    in-out property <string> modal_log_status: "";
    in-out property <string> modal_log_tokens: "";
    in-out property <string> modal_log_latency: "";

    // Proxy Layer Settings
    in-out property <int> routing_strategy_index: 0;
    in-out property <int> cache_affinity_mode_index: 1;
    in-out property <int> session_sticky_ttl_secs: 900;
    in-out property <int> quota_imbalance_threshold: 25;
    in-out property <bool> failover_on_429: true;
    in-out property <int> setting_timeout_secs: 120;
    in-out property <int> setting_heartbeat_secs: 12;

    // Logs Controls
    in-out property <bool> logging_enabled: true;
    in-out property <int> max_log_capacity: 100;

    // Statistics Detailed
    in-out property <int> stat_time_range_index: 0; // 0: Today, 1: 7D, 2: 30D, 3: All
    in-out property <string> stat_prompt_tokens: "0";
    in-out property <string> stat_completion_tokens: "0";
    in-out property <string> stat_thinking_tokens: "0";
    in-out property <string> stat_success_rate: "100%";
    in-out property <string> stat_error_count: "0";
    in-out property <string> stat_max_latency: "0 ms";

    // System Settings
    in-out property <bool> setting_minimize_tray: true;
    in-out property <bool> setting_autostart: false;
    in-out property <bool> setting_portable_mode: false;

    // Callbacks
    callback toggle_proxy();
    callback clear_logs();
    callback toggle_logging();
    callback set_max_logs(int);
    callback add_account();
    callback add_account_browser_oauth();
    callback delete_account(string);
    callback toggle_account_active(string);
    callback refresh_account_quota(string);
    callback open_account_info(string);
    callback open_test_dialog(string);
    callback execute_test_request();
    callback cancel_test_request();
    callback open_log_details(string);
    callback toggle_model(string);
    callback toggle_reasoning_clones_grouping();
    callback set_routing_strategy(int);
    callback set_cache_affinity_mode(int);
    callback set_session_ttl(int);
    callback set_imbalance_threshold(int);
    callback toggle_failover_429();
    callback set_language(int);
    callback set_quota_display_mode(string);
    callback toggle_hide_brand();
    callback save_settings();

    // Main Layout
    HorizontalLayout {
        // Left Navigation Sidebar
        Rectangle {
            width: 200px;
            background: #111113;

            VerticalLayout {
                padding: 14px;
                spacing: 4px;

                // Collapsible App Brand
                if !root.hide_sidebar_brand: HorizontalLayout {
                    padding-bottom: 14px;
                    padding-left: 8px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Aroxy";
                        font-size: 16px;
                        font-weight: 800;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "v0.0.2";
                        font-size: 11px;
                        font-weight: 600;
                        color: #71717a;
                        vertical-alignment: center;
                    }
                }

                // Navigation Tabs
                NavItem {
                    text: root.i18n.tab_dashboard;
                    is_active: root.active_tab == 0;
                    clicked => { root.active_tab = 0; }
                }
                NavItem {
                    text: root.i18n.tab_accounts;
                    is_active: root.active_tab == 1;
                    clicked => { root.active_tab = 1; }
                }
                NavItem {
                    text: root.i18n.tab_models;
                    is_active: root.active_tab == 2;
                    clicked => { root.active_tab = 2; }
                }
                NavItem {
                    text: root.i18n.tab_proxy;
                    is_active: root.active_tab == 3;
                    clicked => { root.active_tab = 3; }
                }
                NavItem {
                    text: root.i18n.tab_logs;
                    is_active: root.active_tab == 4;
                    clicked => { root.active_tab = 4; }
                }
                NavItem {
                    text: root.i18n.tab_stats;
                    is_active: root.active_tab == 5;
                    clicked => { root.active_tab = 5; }
                }
                NavItem {
                    text: root.i18n.tab_settings;
                    is_active: root.active_tab == 6;
                    clicked => { root.active_tab = 6; }
                }

                Rectangle { }
            }
        }

        // Main Workspace
        VerticalLayout {
            padding: 20px;
            spacing: 16px;

            // Top Header Bar
            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: root.active_tab == 0 ? root.i18n.dash_title
                            : root.active_tab == 1 ? root.i18n.acc_title
                            : root.active_tab == 2 ? root.i18n.mod_title
                            : root.active_tab == 3 ? root.i18n.proxy_title
                            : root.active_tab == 4 ? root.i18n.logs_title
                            : root.active_tab == 5 ? root.i18n.stats_title
                            : root.i18n.sett_title;
                        font-size: 18px;
                        font-weight: 800;
                        color: #ffffff;
                    }
                    Text {
                        text: root.active_tab == 0 ? root.i18n.dash_subtitle
                            : root.active_tab == 1 ? root.i18n.acc_subtitle
                            : root.active_tab == 2 ? root.i18n.mod_subtitle
                            : root.active_tab == 3 ? root.i18n.proxy_subtitle
                            : root.active_tab == 4 ? root.i18n.logs_subtitle
                            : root.active_tab == 5 ? root.i18n.stats_subtitle
                            : root.i18n.sett_subtitle;
                        font-size: 11px;
                        color: #71717a;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    ActionButton {
                        text: root.proxy_running ? root.i18n.btn_stop_proxy : root.i18n.btn_start_proxy;
                        is_primary: !root.proxy_running;
                        is_danger: root.proxy_running;
                        is_accent: !root.proxy_running;
                        clicked => { root.toggle_proxy(); }
                    }
                }
            }

            // Scrollable Content View
            ScrollView {
                VerticalLayout {
                    alignment: start;
                    padding-right: 8px;
                    spacing: 14px;

                    // ==========================================
                    // TAB 0: DASHBOARD
                    // ==========================================
                    if root.active_tab == 0: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        // 6 High-Density Stat Cards Filling the Width
                        HorizontalLayout {
                            spacing: 10px;
                            StatCard {
                                title: root.i18n.stat_requests;
                                value: root.total_requests;
                                subtext: "Inbound API calls";
                            }
                            StatCard {
                                title: root.i18n.stat_tokens;
                                value: root.total_tokens;
                                subtext: "Prompt + Completion";
                            }
                            StatCard {
                                title: root.i18n.stat_latency;
                                value: root.avg_latency;
                                subtext: "TTFT stream average";
                            }
                            StatCard {
                                title: root.i18n.stat_accounts;
                                value: root.healthy_accounts_count + "";
                                subtext: "Healthy in pool";
                            }
                            StatCard {
                                title: root.i18n.stat_app_ram;
                                value: root.app_memory;
                                subtext: "Zero-bloat resident";
                            }
                            StatCard {
                                title: root.i18n.stat_proxy_engine;
                                value: root.proxy_running ? "ONLINE" : "STANDBY";
                                subtext: root.proxy_engine_status;
                            }
                        }

                        // Claude & GPT Models Quota Card
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: root.i18n.quota_claude_title; font-size: 13px; font-weight: 700; color: #ffffff; }
                                        Text { text: root.i18n.quota_claude_desc; font-size: 11px; color: #71717a; }
                                    }
                                    Badge {
                                        text: "Resets " + root.global_claude_reset;
                                        is_green: root.global_claude_percent > 20;
                                        is_danger: root.global_claude_percent <= 20;
                                    }
                                }

                                // Progress Bar
                                Rectangle {
                                    height: 8px;
                                    border-radius: 4px;
                                    background: #27272a;

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 8px;
                                        border-radius: 4px;
                                        width: parent.width * (root.global_claude_percent / 100.0);
                                        background: root.global_claude_percent < 20 ? #ef4444 : (root.global_claude_percent < 50 ? #fbbf24 : #4ade80);
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: root.global_claude_label;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: root.global_claude_percent < 20 ? #f87171 : (root.global_claude_percent < 50 ? #fbbf24 : #4ade80);
                                    }
                                    Text {
                                        text: "Routing: Cache Affinity Pool";
                                        font-size: 11px;
                                        color: #71717a;
                                    }
                                }
                            }
                        }

                        // Gemini Models Quota Card
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: root.i18n.quota_gemini_title; font-size: 13px; font-weight: 700; color: #ffffff; }
                                        Text { text: root.i18n.quota_gemini_desc; font-size: 11px; color: #71717a; }
                                    }
                                    Badge {
                                        text: "Resets " + root.global_gemini_reset;
                                        is_green: root.global_gemini_percent > 20;
                                        is_danger: root.global_gemini_percent <= 20;
                                    }
                                }

                                // Progress Bar
                                Rectangle {
                                    height: 8px;
                                    border-radius: 4px;
                                    background: #27272a;

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 8px;
                                        border-radius: 4px;
                                        width: parent.width * (root.global_gemini_percent / 100.0);
                                        background: root.global_gemini_percent < 20 ? #ef4444 : (root.global_gemini_percent < 50 ? #fbbf24 : #4ade80);
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: root.global_gemini_label;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: root.global_gemini_percent < 20 ? #f87171 : (root.global_gemini_percent < 50 ? #fbbf24 : #4ade80);
                                    }
                                    Text {
                                        text: "Multi-Turn Optimized Pool";
                                        font-size: 11px;
                                        color: #71717a;
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 1: ACCOUNTS & QUOTAS
                    // ==========================================
                    if root.active_tab == 1: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        // Add Antigravity Account Box
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Add Antigravity Account"; font-size: 13px; font-weight: 700; color: #ffffff; }
                                        Text { text: "Connect via browser OAuth or paste session token (email & quota are auto-parsed)"; font-size: 11px; color: #71717a; }
                                    }
                                    ActionButton {
                                        text: root.i18n.btn_login_oauth;
                                        is_accent: true;
                                        clicked => { root.add_account_browser_oauth(); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    LineEdit {
                                        placeholder-text: root.i18n.acc_placeholder;
                                        text <=> root.new_acc_token;
                                        horizontal-stretch: 1;
                                    }
                                    ActionButton {
                                        text: root.i18n.btn_add_token;
                                        is_primary: true;
                                        clicked => { root.add_account(); }
                                    }
                                }
                            }
                        }

                        Text { text: root.i18n.acc_pool_header; font-size: 11px; font-weight: 700; color: #71717a; }

                        // Account Cards
                        for acc in root.accounts: Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text { text: acc.name; font-size: 13px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Badge {
                                            text: acc.tier;
                                            is_green: acc.tier == "PRO" || acc.tier == "Pro";
                                        }
                                        Badge {
                                            text: acc.status;
                                            is_green: acc.status == "ACTIVE";
                                            is_danger: acc.status != "ACTIVE";
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        ActionButton {
                                            text: root.i18n.btn_update;
                                            is_primary: false;
                                            clicked => { root.refresh_account_quota(acc.id); }
                                        }
                                        ActionButton {
                                            text: root.i18n.btn_info;
                                            is_primary: false;
                                            clicked => { root.open_account_info(acc.id); }
                                        }
                                        ActionButton {
                                            text: acc.is_active ? root.i18n.btn_disable : root.i18n.btn_enable;
                                            is_primary: !acc.is_active;
                                            is_accent: !acc.is_active;
                                            clicked => { root.toggle_account_active(acc.id); }
                                        }
                                        ActionButton {
                                            text: root.i18n.btn_delete;
                                            is_danger: true;
                                            clicked => { root.delete_account(acc.id); }
                                        }
                                    }
                                }

                                // Claude & GPT Bar
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: root.quota_display_mode == "fraction" 
                                            ? "Claude & GPT: " + ((acc.claude_gpt_percent / 100.0) + "") + " Remaining"
                                            : "Claude & GPT: " + acc.claude_gpt_percent + "% Available";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: acc.claude_gpt_percent < 20 ? #f87171 : (acc.claude_gpt_percent < 50 ? #fbbf24 : #4ade80);
                                    }
                                    Text {
                                        text: "Resets " + acc.claude_gpt_reset;
                                        font-size: 10px;
                                        color: #71717a;
                                    }
                                }
                                Rectangle {
                                    height: 5px;
                                    border-radius: 3px;
                                    background: #27272a;
                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 5px;
                                        border-radius: 3px;
                                        width: parent.width * (acc.claude_gpt_percent / 100.0);
                                        background: acc.claude_gpt_percent < 20 ? #ef4444 : (acc.claude_gpt_percent < 50 ? #fbbf24 : #4ade80);
                                    }
                                }

                                // Gemini Bar
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: root.quota_display_mode == "fraction" 
                                            ? "Gemini: " + ((acc.gemini_percent / 100.0) + "") + " Remaining"
                                            : "Gemini: " + acc.gemini_percent + "% Available";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: acc.gemini_percent < 20 ? #f87171 : (acc.gemini_percent < 50 ? #fbbf24 : #4ade80);
                                    }
                                    Text {
                                        text: "Resets " + acc.gemini_reset;
                                        font-size: 10px;
                                        color: #71717a;
                                    }
                                }
                                Rectangle {
                                    height: 5px;
                                    border-radius: 3px;
                                    background: #27272a;
                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 5px;
                                        border-radius: 3px;
                                        width: parent.width * (acc.gemini_percent / 100.0);
                                        background: acc.gemini_percent < 20 ? #ef4444 : (acc.gemini_percent < 50 ? #fbbf24 : #4ade80);
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 2: MODELS & BROADCAST
                    // ==========================================
                    if root.active_tab == 2: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        // Reasoning Clones Grouping Toggle
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: root.i18n.group_reasoning_title; font-size: 13px; font-weight: 700; color: #ffffff; }
                                        Text { text: root.i18n.group_reasoning_desc; font-size: 11px; color: #71717a; }
                                    }
                                    ToggleSwitch {
                                        checked: root.group_reasoning_clones;
                                        toggled => { root.toggle_reasoning_clones_grouping(); }
                                    }
                                }
                            }
                        }

                        Text { text: "CATALOG MODELS & BROADCAST PERMISSIONS"; font-size: 11px; font-weight: 700; color: #71717a; }

                        // Model Cards
                        for model in root.models: Rectangle {
                            height: 44px;
                            background: #18181b;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #27272a;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Text { text: model.display_name; font-size: 13px; font-weight: 600; color: #ffffff; vertical-alignment: center; }
                                    Badge { text: model.id; }
                                    Badge { text: model.tier; is_green: model.tier == "PRO" || model.tier == "Pro"; }
                                    if model.supports_thinking: Badge { text: "Thinking"; is_amber: true; }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: end;
                                    ActionButton {
                                        text: root.i18n.btn_test_dialog;
                                        is_primary: false;
                                        clicked => { root.open_test_dialog(model.id); }
                                    }
                                    ToggleSwitch {
                                        checked: model.is_enabled;
                                        toggled => { root.toggle_model(model.id); }
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 3: PROXY LAYER ("Прослойка")
                    // ==========================================
                    if root.active_tab == 3: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        // Network Ports & Protocol Tuning
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: root.i18n.sec_network; font-size: 13px; font-weight: 700; color: #ffffff; }

                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: root.i18n.lbl_port; font-size: 11px; font-weight: 600; color: #a1a1aa; }
                                        Rectangle {
                                            height: 32px;
                                            border-radius: 6px;
                                            background: #121214;
                                            border-width: 1px;
                                            border-color: #27272a;
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                Text { text: root.proxy_port + ""; font-size: 12px; color: #ffffff; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: root.i18n.lbl_host; font-size: 11px; font-weight: 600; color: #a1a1aa; }
                                        Rectangle {
                                            height: 32px;
                                            border-radius: 6px;
                                            background: #121214;
                                            border-width: 1px;
                                            border-color: #27272a;
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                Text { text: root.proxy_host; font-size: 12px; color: #ffffff; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: root.i18n.lbl_timeout; font-size: 11px; font-weight: 600; color: #a1a1aa; }
                                        Rectangle {
                                            height: 32px;
                                            border-radius: 6px;
                                            background: #121214;
                                            border-width: 1px;
                                            border-color: #27272a;
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                Text { text: root.setting_timeout_secs + "s"; font-size: 12px; color: #ffffff; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: root.i18n.lbl_heartbeat; font-size: 11px; font-weight: 600; color: #a1a1aa; }
                                        Rectangle {
                                            height: 32px;
                                            border-radius: 6px;
                                            background: #121214;
                                            border-width: 1px;
                                            border-color: #27272a;
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                Text { text: root.setting_heartbeat_secs + "s"; font-size: 12px; color: #ffffff; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Routing Strategy Box
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: root.i18n.sec_routing; font-size: 13px; font-weight: 700; color: #ffffff; }

                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton {
                                        text: "Quota-Aware (Smart)";
                                        is_primary: root.routing_strategy_index == 0;
                                        is_accent: root.routing_strategy_index == 0;
                                        clicked => { root.set_routing_strategy(0); }
                                    }
                                    ActionButton {
                                        text: "Round-Robin";
                                        is_primary: root.routing_strategy_index == 1;
                                        is_accent: root.routing_strategy_index == 1;
                                        clicked => { root.set_routing_strategy(1); }
                                    }
                                    ActionButton {
                                        text: "Failover / Priority";
                                        is_primary: root.routing_strategy_index == 2;
                                        is_accent: root.routing_strategy_index == 2;
                                        clicked => { root.set_routing_strategy(2); }
                                    }
                                }

                                Text {
                                    text: root.routing_strategy_index == 0
                                        ? "• Quota-Aware: Dispatches each incoming request to the healthy account with the highest remaining quota percentage."
                                        : (root.routing_strategy_index == 1
                                            ? "• Round-Robin: Evenly distributes traffic sequentially across all active connected accounts."
                                            : "• Failover: Routes solely to the primary account, automatically falling back to secondary on rate-limit (429).");
                                    font-size: 11px;
                                    color: #a1a1aa;
                                }
                            }
                        }

                        // Prompt Cache Affinity Box
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: root.i18n.sec_cache; font-size: 13px; font-weight: 700; color: #ffffff; }

                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton {
                                        text: "Cache-First (Speed)";
                                        is_primary: root.cache_affinity_mode_index == 0;
                                        is_accent: root.cache_affinity_mode_index == 0;
                                        clicked => { root.set_cache_affinity_mode(0); }
                                    }
                                    ActionButton {
                                        text: "Balanced (Hybrid)";
                                        is_primary: root.cache_affinity_mode_index == 1;
                                        is_accent: root.cache_affinity_mode_index == 1;
                                        clicked => { root.set_cache_affinity_mode(1); }
                                    }
                                    ActionButton {
                                        text: "Aggressive Spread";
                                        is_primary: root.cache_affinity_mode_index == 2;
                                        is_accent: root.cache_affinity_mode_index == 2;
                                        clicked => { root.set_cache_affinity_mode(2); }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_failover; font-size: 12px; font-weight: 600; color: #fafafa; }
                                        Text { text: "Silently and instantly failover to another healthy account if upstream returns 429"; font-size: 11px; color: #71717a; }
                                    }
                                    ToggleSwitch {
                                        checked: root.failover_on_429;
                                        toggled => { root.toggle_failover_429(); }
                                    }
                                }
                            }
                        }

                        // Active Endpoints List (Perfect Spacing, No Collisions!)
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;

                                Text { text: "Active Protocol Endpoints"; font-size: 13px; font-weight: 700; color: #ffffff; }

                                // Table Header
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text { text: "PROTOCOL"; width: 180px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "ENDPOINT PATH"; horizontal-stretch: 1; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "STATUS"; width: 80px; font-size: 10px; font-weight: 700; color: #71717a; horizontal-alignment: right; }
                                }

                                Rectangle {
                                    height: 36px;
                                    border-radius: 6px;
                                    background: #121214;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text { text: "OpenAI v1"; width: 180px; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "http://" + root.proxy_host + ":" + root.proxy_port + "/v1/chat/completions"; horizontal-stretch: 1; font-size: 11px; color: #a1a1aa; vertical-alignment: center; }
                                        Badge { text: root.proxy_running ? "ONLINE" : "OFFLINE"; is_green: root.proxy_running; }
                                    }
                                }

                                Rectangle {
                                    height: 36px;
                                    border-radius: 6px;
                                    background: #121214;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text { text: "Claude Messages"; width: 180px; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "http://" + root.proxy_host + ":" + root.proxy_port + "/v1/messages"; horizontal-stretch: 1; font-size: 11px; color: #a1a1aa; vertical-alignment: center; }
                                        Badge { text: root.proxy_running ? "ONLINE" : "OFFLINE"; is_green: root.proxy_running; }
                                    }
                                }

                                Rectangle {
                                    height: 36px;
                                    border-radius: 6px;
                                    background: #121214;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text { text: "Model Catalog"; width: 180px; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "http://" + root.proxy_host + ":" + root.proxy_port + "/v1/models"; horizontal-stretch: 1; font-size: 11px; color: #a1a1aa; vertical-alignment: center; }
                                        Badge { text: root.proxy_running ? "ONLINE" : "OFFLINE"; is_green: root.proxy_running; }
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 4: TRAFFIC LOGS
                    // ==========================================
                    if root.active_tab == 4: VerticalLayout {
                        alignment: start;
                        spacing: 12px;

                        // Logs Toolbar
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 16px;
                                        alignment: start;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: center;
                                            Text { text: root.i18n.lbl_enable_logging; font-size: 12px; font-weight: 600; color: #ffffff; vertical-alignment: center; }
                                            ToggleSwitch {
                                                checked: root.logging_enabled;
                                                toggled => { root.toggle_logging(); }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: center;
                                            Text { text: root.i18n.lbl_max_logs + ":"; font-size: 11px; color: #71717a; vertical-alignment: center; }
                                            ActionButton {
                                                text: "50";
                                                is_primary: root.max_log_capacity == 50;
                                                is_accent: root.max_log_capacity == 50;
                                                clicked => { root.set_max_logs(50); }
                                            }
                                            ActionButton {
                                                text: "100";
                                                is_primary: root.max_log_capacity == 100;
                                                is_accent: root.max_log_capacity == 100;
                                                clicked => { root.set_max_logs(100); }
                                            }
                                            ActionButton {
                                                text: "250";
                                                is_primary: root.max_log_capacity == 250;
                                                is_accent: root.max_log_capacity == 250;
                                                clicked => { root.set_max_logs(250); }
                                            }
                                            ActionButton {
                                                text: "500";
                                                is_primary: root.max_log_capacity == 500;
                                                is_accent: root.max_log_capacity == 500;
                                                clicked => { root.set_max_logs(500); }
                                            }
                                        }
                                    }

                                    ActionButton {
                                        text: root.i18n.btn_clear_logs;
                                        is_primary: false;
                                        clicked => { root.clear_logs(); }
                                    }
                                }
                            }
                        }

                        // Logs Table
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;

                                // Table Header
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text { text: "TIME"; width: 70px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "METHOD"; width: 60px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "ENDPOINT"; horizontal-stretch: 1; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "MODEL"; width: 160px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "STATUS"; width: 75px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "TOKENS"; width: 60px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "LATENCY"; width: 65px; font-size: 10px; font-weight: 700; color: #71717a; }
                                }

                                for log in root.log_entries: Rectangle {
                                    height: 32px;
                                    border-radius: 6px;
                                    background: #121214;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text { text: log.time; width: 70px; font-size: 11px; color: #71717a; vertical-alignment: center; }
                                        Text { text: log.method; width: 60px; font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: log.path; horizontal-stretch: 1; font-size: 11px; color: #d4d4d8; vertical-alignment: center; }
                                        Text { text: log.model; width: 160px; font-size: 11px; color: #a1a1aa; vertical-alignment: center; }
                                        Text {
                                            text: log.status == 200 ? "200 OK" : (log.status + "");
                                            width: 75px;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: log.status == 200 ? #4ade80 : #f87171;
                                            vertical-alignment: center;
                                        }
                                        Text { text: log.tokens + ""; width: 60px; font-size: 11px; color: #a1a1aa; vertical-alignment: center; }
                                        Text { text: log.latency_ms + "ms"; width: 65px; font-size: 11px; color: #71717a; vertical-alignment: center; }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open_log_details(log.id); }
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 5: STATISTICS
                    // ==========================================
                    if root.active_tab == 5: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        // Time Range Toolbar
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "TIME RANGE:"; font-size: 11px; font-weight: 700; color: #71717a; vertical-alignment: center; }
                            ActionButton {
                                text: "Today";
                                is_primary: root.stat_time_range_index == 0;
                                is_accent: root.stat_time_range_index == 0;
                                clicked => { root.stat_time_range_index = 0; }
                            }
                            ActionButton {
                                text: "7 Days";
                                is_primary: root.stat_time_range_index == 1;
                                is_accent: root.stat_time_range_index == 1;
                                clicked => { root.stat_time_range_index = 1; }
                            }
                            ActionButton {
                                text: "30 Days";
                                is_primary: root.stat_time_range_index == 2;
                                is_accent: root.stat_time_range_index == 2;
                                clicked => { root.stat_time_range_index = 2; }
                            }
                            ActionButton {
                                text: "All Time";
                                is_primary: root.stat_time_range_index == 3;
                                is_accent: root.stat_time_range_index == 3;
                                clicked => { root.stat_time_range_index = 3; }
                            }
                        }

                        // Token Distribution Cards
                        HorizontalLayout {
                            spacing: 12px;
                            StatCard {
                                title: "PROMPT TOKENS";
                                value: root.stat_prompt_tokens;
                                subtext: "Input instruction context";
                            }
                            StatCard {
                                title: "OUTPUT TOKENS";
                                value: root.stat_completion_tokens;
                                subtext: "Standard completion tokens";
                            }
                            StatCard {
                                title: "THINKING TOKENS";
                                value: root.stat_thinking_tokens;
                                subtext: "Extended reasoning budget";
                            }
                        }

                        // Quality of Service
                        HorizontalLayout {
                            spacing: 12px;
                            StatCard {
                                title: "SUCCESS RATE";
                                value: root.stat_success_rate;
                                subtext: "HTTP 2xx completion ratio";
                            }
                            StatCard {
                                title: "FAILOVERS / 429";
                                value: root.stat_error_count;
                                subtext: "Automatic retry rotations";
                            }
                            StatCard {
                                title: "PEAK LATENCY";
                                value: root.stat_max_latency;
                                subtext: "Max recorded wait time";
                            }
                        }

                        // Token Distribution Bar Diagram
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                Text { text: "Token Volume Breakdown Visualizer"; font-size: 13px; font-weight: 700; color: #ffffff; }

                                Rectangle {
                                    height: 14px;
                                    border-radius: 7px;
                                    background: #27272a;

                                    HorizontalLayout {
                                        Rectangle {
                                            horizontal-stretch: 45;
                                            background: #3b82f6;
                                            border-radius: 7px;
                                        }
                                        Rectangle {
                                            horizontal-stretch: 40;
                                            background: #10b981;
                                            border-radius: 7px;
                                        }
                                        Rectangle {
                                            horizontal-stretch: 15;
                                            background: #f59e0b;
                                            border-radius: 7px;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 16px;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #3b82f6; }
                                        Text { text: "Prompt (45%)"; font-size: 11px; color: #a1a1aa; vertical-alignment: center; }
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #10b981; }
                                        Text { text: "Output (40%)"; font-size: 11px; color: #a1a1aa; vertical-alignment: center; }
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #f59e0b; }
                                        Text { text: "Thinking (15%)"; font-size: 11px; color: #a1a1aa; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 6: SETTINGS
                    // ==========================================
                    if root.active_tab == 6: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        // Visual Preferences Section
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                Text { text: root.i18n.sec_visual; font-size: 13px; font-weight: 700; color: #ffffff; }

                                // Language Switcher
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_language; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Select application interface language"; font-size: 11px; color: #71717a; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        ActionButton {
                                            text: "English";
                                            is_primary: root.current_language == 0;
                                            is_accent: root.current_language == 0;
                                            clicked => { root.set_language(0); }
                                        }
                                        ActionButton {
                                            text: "Русский";
                                            is_primary: root.current_language == 1;
                                            is_accent: root.current_language == 1;
                                            clicked => { root.set_language(1); }
                                        }
                                        ActionButton {
                                            text: "中文";
                                            is_primary: root.current_language == 2;
                                            is_accent: root.current_language == 2;
                                            clicked => { root.set_language(2); }
                                        }
                                    }
                                }

                                // Quota Display Mode (Percentage vs Fraction)
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_quota_mode; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Choose between percentage gauges and original remaining fraction"; font-size: 11px; color: #71717a; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        ActionButton {
                                            text: root.i18n.opt_quota_percent;
                                            is_primary: root.quota_display_mode == "percent";
                                            is_accent: root.quota_display_mode == "percent";
                                            clicked => { root.set_quota_display_mode("percent"); }
                                        }
                                        ActionButton {
                                            text: root.i18n.opt_quota_fraction;
                                            is_primary: root.quota_display_mode == "fraction";
                                            is_accent: root.quota_display_mode == "fraction";
                                            clicked => { root.set_quota_display_mode("fraction"); }
                                        }
                                    }
                                }

                                // Hide Brand in Sidebar Toggle
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_hide_brand; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Hides Aroxy brand header in sidebar, smoothly shifting navigation tabs up"; font-size: 11px; color: #71717a; }
                                    }
                                    ToggleSwitch {
                                        checked: root.hide_sidebar_brand;
                                        toggled => { root.toggle_hide_brand(); }
                                    }
                                }
                            }
                        }

                        // System Preferences Section
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                Text { text: root.i18n.sec_system; font-size: 13px; font-weight: 700; color: #ffffff; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_tray; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Keeps the proxy daemon serving API requests silently in the background"; font-size: 11px; color: #71717a; }
                                    }
                                    ToggleSwitch {
                                        checked: root.setting_minimize_tray;
                                        toggled => { root.setting_minimize_tray = !root.setting_minimize_tray; }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_autostart; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Launches Aroxy daemon on user login"; font-size: 11px; color: #71717a; }
                                    }
                                    ToggleSwitch {
                                        checked: root.setting_autostart;
                                        toggled => { root.setting_autostart = !root.setting_autostart; }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_portable; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Store configuration in aroxy.json next to binary instead of OS AppData"; font-size: 11px; color: #71717a; }
                                    }
                                    ToggleSwitch {
                                        checked: root.setting_portable_mode;
                                        toggled => { root.setting_portable_mode = !root.setting_portable_mode; }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: end;
                                    ActionButton {
                                        text: root.i18n.btn_save_settings;
                                        is_accent: true;
                                        clicked => { root.save_settings(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ============================================================
    // MODAL 1: ACCOUNT DETAILS DIALOG
    // ============================================================
    if root.show_account_info: Rectangle {
        background: #000000bb;
        TouchArea { } // Backdrop capture

        Rectangle {
            width: 460px;
            background: #18181b;
            border-radius: 10px;
            border-width: 1px;
            border-color: #3f3f46;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Account Details"; font-size: 15px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                    ActionButton {
                        text: "Close";
                        is_primary: false;
                        clicked => { root.show_account_info = false; }
                    }
                }

                Rectangle { height: 1px; background: #27272a; }

                HorizontalLayout {
                    spacing: 10px;
                    Text { text: root.info_account_name; font-size: 13px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                    Badge { text: root.info_account_tier; is_green: root.info_account_tier == "PRO" || root.info_account_tier == "Pro"; }
                    Badge { text: root.info_account_status; is_green: root.info_account_status == "ACTIVE"; is_danger: root.info_account_status != "ACTIVE"; }
                }

                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Claude & GPT Quota: " + root.info_account_claude; font-size: 12px; color: #d4d4d8; }
                    Text { text: "Gemini Quota: " + root.info_account_gemini; font-size: 12px; color: #d4d4d8; }
                    Text { text: "Active Catalog: " + root.info_account_models; font-size: 12px; color: #71717a; }
                }
            }
        }
    }

    // ============================================================
    // MODAL 2: TEST MODEL REQUEST DIALOG
    // ============================================================
    if root.show_test_dialog: Rectangle {
        background: #000000bb;
        TouchArea { } // Backdrop capture

        Rectangle {
            width: 580px;
            background: #18181b;
            border-radius: 10px;
            border-width: 1px;
            border-color: #3f3f46;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: root.i18n.test_dialog_title; font-size: 14px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                        Badge { text: root.test_model_id; is_green: true; }
                    }
                    ActionButton {
                        text: root.i18n.btn_close;
                        is_primary: false;
                        clicked => { root.show_test_dialog = false; }
                    }
                }

                Rectangle { height: 1px; background: #27272a; }

                // Test Prompt
                Text { text: root.i18n.test_prompt_label; font-size: 11px; font-weight: 600; color: #a1a1aa; }
                LineEdit {
                    text <=> root.test_prompt;
                    placeholder-text: "Enter a test prompt to dispatch via Aroxy...";
                }

                // Parameters
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: root.i18n.test_timeout_label; font-size: 10px; font-weight: 600; color: #71717a; }
                        LineEdit { text <=> root.test_timeout_secs; }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: root.i18n.test_max_tokens_label; font-size: 10px; font-weight: 600; color: #71717a; }
                        LineEdit { text <=> root.test_max_tokens; }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Temperature"; font-size: 10px; font-weight: 600; color: #71717a; }
                        LineEdit { text <=> root.test_temperature; }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        alignment: center;
                        Text { text: root.i18n.test_stream_toggle; font-size: 10px; font-weight: 600; color: #71717a; }
                        ToggleSwitch {
                            checked: root.test_stream;
                            toggled => { root.test_stream = !root.test_stream; }
                        }
                    }
                }

                // Controls row
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Status: " + root.test_status + " | " + root.test_latency + " | " + root.test_tokens + " tok";
                        font-size: 11px;
                        color: #a1a1aa;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        if root.test_running: ActionButton {
                            text: root.i18n.btn_cancel_test;
                            is_danger: true;
                            clicked => { root.cancel_test_request(); }
                        }
                        ActionButton {
                            text: root.test_running ? "Sending..." : root.i18n.btn_send_test;
                            is_accent: !root.test_running;
                            is_disabled: root.test_running;
                            clicked => { root.execute_test_request(); }
                        }
                    }
                }

                // Output Viewer
                Rectangle {
                    height: 140px;
                    border-radius: 6px;
                    background: #111113;
                    border-width: 1px;
                    border-color: #27272a;

                    ScrollView {
                        VerticalLayout {
                            padding: 10px;
                            Text {
                                text: root.test_response == "" ? "Response body and streaming chunks will appear here..." : root.test_response;
                                font-size: 11px;
                                color: root.test_response == "" ? #52525b : #e4e4e7;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }

    // ============================================================
    // MODAL 3: LOG DETAILS INSPECTOR
    // ============================================================
    if root.show_log_modal: Rectangle {
        background: #000000bb;
        TouchArea { } // Backdrop capture

        Rectangle {
            width: 520px;
            background: #18181b;
            border-radius: 10px;
            border-width: 1px;
            border-color: #3f3f46;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "HTTP Request Inspector"; font-size: 15px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                    ActionButton {
                        text: "Close";
                        is_primary: false;
                        clicked => { root.show_log_modal = false; }
                    }
                }

                Rectangle { height: 1px; background: #27272a; }

                HorizontalLayout {
                    spacing: 10px;
                    Badge { text: root.modal_log_method; is_green: true; }
                    Text { text: root.modal_log_path; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                    Badge { text: root.modal_log_status; is_green: root.modal_log_status == "200 OK"; is_danger: root.modal_log_status != "200 OK"; }
                }

                VerticalLayout {
                    spacing: 8px;
                    Text { text: "Timestamp: " + root.modal_log_time; font-size: 12px; color: #a1a1aa; }
                    Text { text: "Dispatched Model: " + root.modal_log_model; font-size: 12px; color: #a1a1aa; }
                    Text { text: "Processed Tokens: " + root.modal_log_tokens; font-size: 12px; color: #a1a1aa; }
                    Text { text: "Response Latency: " + root.modal_log_latency; font-size: 12px; color: #a1a1aa; }
                }
            }
        }
    }
}
