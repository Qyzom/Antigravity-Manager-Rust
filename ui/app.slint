component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> is_active: false;
    callback clicked;

    height: 38px;
    border-radius: 6px;
    background: root.is_active ? #27272a : (touch.has-hover ? #18181b : transparent);
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: start;

        Text {
            text: root.text;
            font-size: 13px;
            font-weight: root.is_active ? 700 : 500;
            color: root.is_active ? #fafafa : (touch.has-hover ? #e4e4e7 : #a1a1aa);
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> is_primary: true;
    in property <bool> is_danger: false;
    in property <bool> is_accent: false;
    in property <bool> is_disabled: false;
    in property <length> custom_height: 32px;
    callback clicked;

    height: root.custom_height;
    min-width: txt_el.min-width + 20px;
    border-radius: 6px;
    background: root.is_disabled
        ? #1c1c1f
        : (root.is_danger 
            ? (touch.pressed ? #5f1515 : (touch.has-hover ? #7f1d1d : #451010))
            : (root.is_accent
                ? (touch.pressed ? #e4e4e7 : (touch.has-hover ? #ffffff : #f4f4f5))
                : (root.is_primary 
                    ? (touch.pressed ? #323236 : (touch.has-hover ? #3f3f46 : #27272a))
                    : (touch.pressed ? #121214 : (touch.has-hover ? #202023 : #18181b)))));
    border-width: 1px;
    border-color: root.is_disabled ? #27272a : (root.is_danger ? #991b1b : (root.is_accent ? #ffffff : #3f3f46));
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        txt_el := Text {
            text: root.text;
            font-size: 11px;
            font-weight: 700;
            color: root.is_disabled ? #52525b : (root.is_danger ? #fca5a5 : (root.is_accent ? #09090b : #fafafa));
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.is_disabled ? default : pointer;
        clicked => {
            if !root.is_disabled {
                root.clicked();
            }
        }
    }
}

component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled;

    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? #f4f4f5 : #27272a;
    border-width: 1px;
    border-color: #3f3f46;
    animate background { duration: 150ms; }

    Rectangle {
        x: root.checked ? 22px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.checked ? #09090b : #71717a;
        animate x { duration: 150ms; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component StatCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> subtext;

    background: #18181b;
    border-radius: 8px;
    border-width: 1px;
    border-color: #27272a;

    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        alignment: space-between;

        Text {
            text: root.title;
            font-size: 10px;
            font-weight: 700;
            color: #71717a;
            letter-spacing: 0.5px;
        }
        Text {
            text: root.value;
            font-size: 20px;
            font-weight: 800;
            color: #fafafa;
        }
        Text {
            text: root.subtext;
            font-size: 10px;
            color: #a1a1aa;
        }
    }
}

component CircularChart inherits Rectangle {
    in property <length> chart_size: 110px;
    in property <string> path_bg: "";
    in property <string> path_seg1: "";
    in property <color> color_seg1: #3b82f6;
    in property <string> path_seg2: "";
    in property <color> color_seg2: #10b981;
    in property <string> path_seg3: "";
    in property <color> color_seg3: #f59e0b;
    in property <string> center_title: "0";
    in property <string> center_subtitle: "TOTAL";
    in property <length> stroke_w: 8px;

    width: root.chart_size;
    height: root.chart_size;

    Path {
        width: parent.width;
        height: parent.height;
        commands: root.path_bg;
        stroke: #27272a;
        stroke-width: root.stroke_w;
    }

    if root.path_seg1 != "": Path {
        width: parent.width;
        height: parent.height;
        commands: root.path_seg1;
        stroke: root.color_seg1;
        stroke-width: root.stroke_w;
    }

    if root.path_seg2 != "": Path {
        width: parent.width;
        height: parent.height;
        commands: root.path_seg2;
        stroke: root.color_seg2;
        stroke-width: root.stroke_w;
    }

    if root.path_seg3 != "": Path {
        width: parent.width;
        height: parent.height;
        commands: root.path_seg3;
        stroke: root.color_seg3;
        stroke-width: root.stroke_w;
    }

    VerticalLayout {
        alignment: center;
        spacing: 1px;
        Text {
            text: root.center_title;
            font-size: 13px;
            font-weight: 800;
            color: #ffffff;
            horizontal-alignment: center;
        }
        Text {
            text: root.center_subtitle;
            font-size: 8px;
            font-weight: 700;
            color: #71717a;
            horizontal-alignment: center;
        }
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <bool> is_green: false;
    in property <bool> is_amber: false;
    in property <bool> is_danger: false;

    height: 20px;
    border-radius: 4px;
    background: root.is_green ? #14281e : (root.is_amber ? #291c10 : (root.is_danger ? #291212 : #27272a));
    border-width: 1px;
    border-color: root.is_green ? #1e4a34 : (root.is_amber ? #4e3518 : (root.is_danger ? #4a1c1c : #3f3f46));

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.text;
                font-size: 10px;
                font-weight: 700;
                color: root.is_green ? #4ade80 : (root.is_amber ? #fbbf24 : (root.is_danger ? #f87171 : #d4d4d8));
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Aroxy";
    default-font-family: "Unbounded";
    min-width: 1080px;
    min-height: 720px;
    max-width: 1080px;
    max-height: 720px;
    background: #09090b;

    // Translations
    in-out property <I18nData> i18n;
    in-out property <int> current_language: 0; // 0: EN, 1: RU, 2: ZH

    // Navigation & Status
    in-out property <int> active_tab: 0;
    in-out property <bool> proxy_running: false;
    in-out property <int> proxy_port: 8045;
    in-out property <string> proxy_host: "127.0.0.1";
    in-out property <string> active_model: "claude-3-7-sonnet";
    in-out property <bool> expose_reasoning_variants: true;
    in-out property <bool> group_reasoning_clones: true;

    // Visual Preferences
    in-out property <string> quota_display_mode: "percent"; // "percent" or "fraction"
    in-out property <bool> hide_sidebar_brand: false;

    // Dashboard Overview Metrics
    in-out property <string> total_requests: "0";
    in-out property <string> total_tokens: "0";
    in-out property <string> avg_latency: "0 ms";
    in-out property <string> app_memory: "16.5 MB";
    in-out property <string> proxy_engine_status: "Tokio Lock-Free";
    in-out property <string> quota_view_mode: "both"; // "both", "5hour", "weekly"
    in-out property <int> global_claude_percent: 100;
    in-out property <string> global_claude_label: "100% Available";
    in-out property <string> global_claude_reset: "in 4h 00m";
    in-out property <int> global_claude_weekly_percent: 100;
    in-out property <string> global_claude_weekly_label: "100% Available";
    in-out property <string> global_claude_weekly_reset: "in 7d 00h";
    in-out property <int> global_gemini_percent: 100;
    in-out property <string> global_gemini_label: "100% Available";
    in-out property <string> global_gemini_reset: "in 4h 00m";
    in-out property <int> global_gemini_weekly_percent: 100;
    in-out property <string> global_gemini_weekly_label: "100% Available";
    in-out property <string> global_gemini_weekly_reset: "in 7d 00h";
    in-out property <int> healthy_accounts_count: 0;

    // Config Folder
    in-out property <string> config_folder_path: "";
    in-out property <string> config_folder_size: "";
    in-out property <string> proxy_port_input: "8045";
    in-out property <string> proxy_host_input: "127.0.0.1";
    in-out property <string> setting_timeout_str: "120";
    in-out property <string> setting_heartbeat_str: "12";

    // Lists
    in-out property <[LogEntryData]> log_entries: [];
    in-out property <[AccountData]> accounts: [];
    in-out property <[ModelItemData]> models: [];

    // Account Form
    in-out property <string> new_acc_token: "";

    // Modal 1: Account Info Modal
    in-out property <bool> show_account_info: false;
    in-out property <string> info_account_name: "";
    in-out property <string> info_account_tier: "";
    in-out property <string> info_account_status: "ACTIVE";
    in-out property <string> info_account_claude: "";
    in-out property <string> info_account_gemini: "";
    in-out property <string> info_account_models: "";
    in-out property <int> info_account_claude_5h_pct: 100;
    in-out property <string> info_account_claude_5h_reset: "";
    in-out property <int> info_account_claude_week_pct: 100;
    in-out property <string> info_account_claude_week_reset: "";
    in-out property <int> info_account_gemini_5h_pct: 100;
    in-out property <string> info_account_gemini_5h_reset: "";
    in-out property <int> info_account_gemini_week_pct: 100;
    in-out property <string> info_account_gemini_week_reset: "";
    in-out property <string> info_account_fingerprint: "";

    // Master API Key & Extra Dashboard Metrics
    in-out property <string> master_api_key: "sk-aroxy-v1-master-key";
    in-out property <string> master_key_status_text: "Copy Key";
    in-out property <string> github_update_status: "Check for Updates";
    in-out property <bool> github_checking_update: false;
    in-out property <string> active_primary_account: "Auto-Selected";
    in-out property <int> active_sessions_count: 0;

    // Modal 2: Test Model Dialog
    in-out property <bool> show_test_dialog: false;
    in-out property <string> test_model_id: "claude-3-7-sonnet";
    in-out property <string> test_prompt: "What is 15 * 2? Answer in one word.";
    in-out property <string> test_timeout_secs: "60";
    in-out property <string> test_max_tokens: "2048";
    in-out property <string> test_temperature: "0.7";
    in-out property <bool> test_stream: true;
    in-out property <bool> test_running: false;
    in-out property <string> test_status: "Ready";
    in-out property <string> test_latency: "0 ms";
    in-out property <string> test_tokens: "0";
    in-out property <string> test_response: "";

    // Modal 3: Log Details Inspector
    in-out property <bool> show_log_modal: false;
    in-out property <string> modal_log_time: "";
    in-out property <string> modal_log_method: "";
    in-out property <string> modal_log_path: "";
    in-out property <string> modal_log_model: "";
    in-out property <string> modal_log_status: "";
    in-out property <string> modal_log_tokens: "";
    in-out property <string> modal_log_latency: "";

    // Proxy Layer Settings
    in-out property <int> routing_strategy_index: 0;
    in-out property <int> cache_affinity_mode_index: 1;
    in-out property <int> session_sticky_ttl_secs: 900;
    in-out property <int> quota_imbalance_threshold: 25;
    in-out property <bool> failover_on_429: true;
    in-out property <int> setting_timeout_secs: 120;
    in-out property <int> setting_heartbeat_secs: 12;
    in-out property <int> quota_protection_threshold: 5;

    // Refresh Cadence
    in-out property <int> active_account_refresh_mins: 2;
    in-out property <int> pool_account_refresh_mins: 15;

    // Logs Controls
    in-out property <bool> logging_enabled: true;
    in-out property <int> max_log_capacity: 100;
    in-out property <string> max_log_capacity_input: "100";

    // Statistics Detailed
    in-out property <int> stat_time_range_index: 0; // 0: Today, 1: 7D, 2: 30D, 3: All
    in-out property <string> stat_prompt_tokens: "0";
    in-out property <string> stat_completion_tokens: "0";
    in-out property <string> stat_thinking_tokens: "0";
    in-out property <int> stat_prompt_pct: 50;
    in-out property <int> stat_comp_pct: 40;
    in-out property <int> stat_think_pct: 10;
    in-out property <string> stat_success_rate: "100%";
    in-out property <string> stat_error_count: "0";
    in-out property <string> stat_max_latency: "0 ms";
    in-out property <string> stat_model_distribution: "Claude: 50% | Gemini: 50%";
    in-out property <int> stat_claude_pct: 50;
    in-out property <int> stat_gemini_pct: 50;

    // Circular Chart Vector Paths
    in-out property <string> stat_chart1_path_bg: "M 55.0 13.0 A 42.0 42.0 0 1 1 55.0 97.0 A 42.0 42.0 0 1 1 55.0 13.0";
    in-out property <string> stat_chart1_path1: "";
    in-out property <string> stat_chart1_path2: "";
    in-out property <string> stat_chart1_path3: "";
    in-out property <string> stat_chart2_path_bg: "M 55.0 13.0 A 42.0 42.0 0 1 1 55.0 97.0 A 42.0 42.0 0 1 1 55.0 13.0";
    in-out property <string> stat_chart2_path_succ: "";
    in-out property <string> stat_chart2_path_err: "";
    in-out property <string> stat_chart3_path_bg: "M 55.0 13.0 A 42.0 42.0 0 1 1 55.0 97.0 A 42.0 42.0 0 1 1 55.0 13.0";
    in-out property <string> stat_chart3_path1: "";
    in-out property <string> stat_chart3_path2: "";

    // Preferences & Toggles
    in-out property <bool> show_logs_tab: true;
    in-out property <bool> show_stats_tab: true;
    in-out property <bool> hide_about_tab: false;
    in-out property <length> accounts_scroll_y: 0px;
    in-out property <bool> setting_minimize_tray: true;
    in-out property <bool> setting_autostart: false;
    in-out property <bool> setting_portable_mode: false;
    in-out property <bool> setting_check_updates: true;
    in-out property <bool> setting_clear_logs_exit: false;
    in-out property <string> info_account_error: "";
    in-out property <string> info_account_added_at: "";

    // Callbacks
    callback toggle_proxy();
    callback clear_logs();
    callback toggle_logging();
    callback set_max_logs(int);
    callback set_max_log_capacity_str(string);
    callback add_account();
    callback add_account_browser_oauth();
    callback delete_account(string);
    callback toggle_account_active(string);
    callback refresh_account_quota(string);
    callback open_account_info(string);
    callback open_test_dialog(string);
    callback execute_test_request();
    callback cancel_test_request();
    callback open_log_details(string);
    callback toggle_model(string);
    callback toggle_reasoning_clones_grouping();
    callback set_routing_strategy(int);
    callback set_cache_affinity_mode(int);
    callback set_session_ttl(int);
    callback set_imbalance_threshold(int);
    callback toggle_failover_429();
    callback set_quota_protection_threshold(int);
    callback set_active_refresh_cadence(int);
    callback set_pool_refresh_cadence(int);
    callback toggle_show_logs();
    callback toggle_show_stats();
    callback toggle_hide_about_tab();
    callback toggle_check_updates();
    callback toggle_clear_logs_exit();
    callback toggle_minimize_tray();
    callback toggle_autostart();
    callback toggle_portable_mode();
    callback set_language(int);
    callback set_quota_display_mode(string);
    callback set_quota_view_mode(string);
    callback open_config_folder();
    callback open_github_repo();
    callback open_github_releases();
    callback set_proxy_port_str(string);
    callback set_proxy_host_str(string);
    callback set_proxy_timeout_str(string);
    callback set_proxy_heartbeat_str(string);
    callback toggle_hide_brand();
    callback copy_master_key();
    callback regenerate_master_key();
    callback check_github_updates();

    // Main Layout
    HorizontalLayout {
        // Left Navigation Sidebar
        Rectangle {
            width: 200px;
            background: #111113;

            VerticalLayout {
                padding: 14px;
                spacing: 4px;

                // Collapsible App Brand
                if !root.hide_sidebar_brand: HorizontalLayout {
                    padding-bottom: 14px;
                    padding-left: 8px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Aroxy";
                        font-size: 16px;
                        font-weight: 800;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "v0.0.2";
                        font-size: 11px;
                        font-weight: 600;
                        color: #71717a;
                        vertical-alignment: center;
                    }
                }

                // Navigation Tabs
                NavItem {
                    text: root.i18n.tab_dashboard;
                    is_active: root.active_tab == 0;
                    clicked => { root.active_tab = 0; }
                }
                NavItem {
                    text: root.i18n.tab_accounts;
                    is_active: root.active_tab == 1;
                    clicked => { root.active_tab = 1; }
                }
                NavItem {
                    text: root.i18n.tab_models;
                    is_active: root.active_tab == 2;
                    clicked => { root.active_tab = 2; }
                }
                NavItem {
                    text: root.i18n.tab_proxy;
                    is_active: root.active_tab == 3;
                    clicked => { root.active_tab = 3; }
                }
                if root.show_logs_tab: NavItem {
                    text: root.i18n.tab_logs;
                    is_active: root.active_tab == 4;
                    clicked => { root.active_tab = 4; }
                }
                if root.show_stats_tab: NavItem {
                    text: root.i18n.tab_stats;
                    is_active: root.active_tab == 5;
                    clicked => { root.active_tab = 5; }
                }
                NavItem {
                    text: root.i18n.tab_settings;
                    is_active: root.active_tab == 6;
                    clicked => { root.active_tab = 6; }
                }
                if !root.hide_about_tab: NavItem {
                    text: root.i18n.tab_about;
                    is_active: root.active_tab == 7;
                    clicked => { root.active_tab = 7; }
                }

                Rectangle { }
            }
        }

        // Main Workspace
        VerticalLayout {
            padding: 20px;
            spacing: 16px;

            // Top Header Bar
            HorizontalLayout {
                padding-right: 18px;
                alignment: space-between;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: root.active_tab == 0 ? root.i18n.dash_title
                            : root.active_tab == 1 ? root.i18n.acc_title
                            : root.active_tab == 2 ? root.i18n.mod_title
                            : root.active_tab == 3 ? root.i18n.proxy_title
                            : root.active_tab == 4 ? root.i18n.logs_title
                            : root.active_tab == 5 ? root.i18n.stats_title
                            : root.active_tab == 6 ? root.i18n.sett_title
                            : root.i18n.about_title;
                        font-size: 18px;
                        font-weight: 800;
                        color: #ffffff;
                    }
                    Text {
                        text: root.active_tab == 0 ? root.i18n.dash_subtitle
                            : root.active_tab == 1 ? root.i18n.acc_subtitle
                            : root.active_tab == 2 ? root.i18n.mod_subtitle
                            : root.active_tab == 3 ? root.i18n.proxy_subtitle
                            : root.active_tab == 4 ? root.i18n.logs_subtitle
                            : root.active_tab == 5 ? root.i18n.stats_subtitle
                            : root.active_tab == 6 ? root.i18n.sett_subtitle
                            : root.i18n.about_subtitle;
                        font-size: 11px;
                        color: #71717a;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    ActionButton {
                        text: root.proxy_running ? root.i18n.btn_stop_proxy : root.i18n.btn_start_proxy;
                        is_primary: !root.proxy_running;
                        is_danger: root.proxy_running;
                        is_accent: !root.proxy_running;
                        clicked => { root.toggle_proxy(); }
                    }
                }
            }

            // Scrollable Content View
            ScrollView {
                VerticalLayout {
                    alignment: start;
                    padding-right: 8px;
                    spacing: 14px;

                    // ==========================================
                    // TAB 0: DASHBOARD
                    // ==========================================
                    if root.active_tab == 0: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        // 3 Clean, Focused Metric Cards
                        HorizontalLayout {
                            spacing: 12px;
                            StatCard {
                                title: root.i18n.stat_requests;
                                value: root.total_requests;
                                subtext: "Inbound requests";
                            }
                            StatCard {
                                title: root.i18n.stat_app_ram;
                                value: root.app_memory;
                                subtext: "Process RAM";
                            }
                            StatCard {
                                title: root.i18n.stat_proxy_engine;
                                value: root.proxy_running ? ("ONLINE (" + root.proxy_port + ")") : "STANDBY";
                                subtext: root.proxy_engine_status;
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            StatCard {
                                title: "PRIMARY UPSTREAM";
                                value: root.active_primary_account;
                                subtext: "Routing target";
                            }
                            StatCard {
                                title: "SESSION AFFINITY";
                                value: root.active_sessions_count + " Active";
                                subtext: "Cached sessions";
                            }
                            StatCard {
                                title: "DISPATCH ENGINE";
                                value: root.routing_strategy_index == 1 ? "Quota-Aware" : (root.routing_strategy_index == 2 ? "Lowest-Latency" : "Round-Robin");
                                subtext: "Failover 429 active";
                            }
                        }

                        // Claude & GPT Models Quota Card
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: root.i18n.quota_claude_title; font-size: 13px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        if root.quota_view_mode != "weekly": Badge {
                                            text: "5h Reset: " + root.global_claude_reset;
                                            is_green: root.global_claude_percent > 20;
                                            is_amber: root.global_claude_percent > 0 && root.global_claude_percent <= 20;
                                            is_danger: root.global_claude_percent <= 0;
                                        }
                                        if root.quota_view_mode != "5hour": Badge {
                                            text: "Week Reset: " + root.global_claude_weekly_reset;
                                            is_green: root.global_claude_weekly_percent > 20;
                                            is_amber: root.global_claude_weekly_percent > 0 && root.global_claude_weekly_percent <= 20;
                                            is_danger: root.global_claude_weekly_percent <= 0;
                                        }
                                    }
                                }

                                if root.quota_view_mode != "weekly": VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "5-Hour Rolling: " + root.global_claude_label; font-size: 11px; font-weight: 700; color: root.global_claude_percent <= 0 ? #f87171 : (root.global_claude_percent <= 20 ? #fbbf24 : #4ade80); }
                                    }
                                    Rectangle {
                                        height: 6px;
                                        border-radius: 3px;
                                        background: #27272a;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: 6px;
                                            border-radius: 3px;
                                            width: parent.width * (root.global_claude_percent / 100.0);
                                            background: root.global_claude_percent <= 0 ? #ef4444 : (root.global_claude_percent <= 20 ? #eab308 : #4ade80);
                                        }
                                    }
                                }

                                if root.quota_view_mode != "5hour": VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Weekly Quota: " + root.global_claude_weekly_label; font-size: 11px; font-weight: 700; color: root.global_claude_weekly_percent <= 0 ? #f87171 : (root.global_claude_weekly_percent <= 20 ? #fbbf24 : #4ade80); }
                                    }
                                    Rectangle {
                                        height: 6px;
                                        border-radius: 3px;
                                        background: #27272a;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: 6px;
                                            border-radius: 3px;
                                            width: parent.width * (root.global_claude_weekly_percent / 100.0);
                                            background: root.global_claude_weekly_percent <= 0 ? #ef4444 : (root.global_claude_weekly_percent <= 20 ? #eab308 : #4ade80);
                                        }
                                    }
                                }
                            }
                        }

                        // Gemini Models Quota Card
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: root.i18n.quota_gemini_title; font-size: 13px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        if root.quota_view_mode != "weekly": Badge {
                                            text: "5h Reset: " + root.global_gemini_reset;
                                            is_green: root.global_gemini_percent > 20;
                                            is_amber: root.global_gemini_percent > 0 && root.global_gemini_percent <= 20;
                                            is_danger: root.global_gemini_percent <= 0;
                                        }
                                        if root.quota_view_mode != "5hour": Badge {
                                            text: "Week Reset: " + root.global_gemini_weekly_reset;
                                            is_green: root.global_gemini_weekly_percent > 20;
                                            is_amber: root.global_gemini_weekly_percent > 0 && root.global_gemini_weekly_percent <= 20;
                                            is_danger: root.global_gemini_weekly_percent <= 0;
                                        }
                                    }
                                }

                                if root.quota_view_mode != "weekly": VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "5-Hour Rolling: " + root.global_gemini_label; font-size: 11px; font-weight: 700; color: root.global_gemini_percent <= 0 ? #f87171 : (root.global_gemini_percent <= 20 ? #fbbf24 : #4ade80); }
                                    }
                                    Rectangle {
                                        height: 6px;
                                        border-radius: 3px;
                                        background: #27272a;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: 6px;
                                            border-radius: 3px;
                                            width: parent.width * (root.global_gemini_percent / 100.0);
                                            background: root.global_gemini_percent <= 0 ? #ef4444 : (root.global_gemini_percent <= 20 ? #eab308 : #4ade80);
                                        }
                                    }
                                }

                                if root.quota_view_mode != "5hour": VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Weekly Quota: " + root.global_gemini_weekly_label; font-size: 11px; font-weight: 700; color: root.global_gemini_weekly_percent <= 0 ? #f87171 : (root.global_gemini_weekly_percent <= 20 ? #fbbf24 : #4ade80); }
                                    }
                                    Rectangle {
                                        height: 6px;
                                        border-radius: 3px;
                                        background: #27272a;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: 6px;
                                            border-radius: 3px;
                                            width: parent.width * (root.global_gemini_weekly_percent / 100.0);
                                            background: root.global_gemini_weekly_percent <= 0 ? #ef4444 : (root.global_gemini_weekly_percent <= 20 ? #eab308 : #4ade80);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 1: ACCOUNTS & QUOTAS
                    // ==========================================
                    if root.active_tab == 1: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        // Add Antigravity Account Box
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Add Antigravity Account"; font-size: 13px; font-weight: 700; color: #ffffff; }
                                        Text { text: "Connect via browser OAuth or paste session token (email & quota are auto-parsed)"; font-size: 11px; color: #71717a; }
                                    }
                                    ActionButton {
                                        text: root.i18n.btn_login_oauth;
                                        is_accent: true;
                                        clicked => { root.add_account_browser_oauth(); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    LineEdit {
                                        placeholder-text: root.i18n.acc_placeholder;
                                        text <=> root.new_acc_token;
                                        horizontal-stretch: 1;
                                    }
                                    ActionButton {
                                        text: root.i18n.btn_add_token;
                                        is_primary: true;
                                        clicked => { root.add_account(); }
                                    }
                                }
                            }
                        }

                        // Accounts Auto-Refresh Cadence Toolbar
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_active_refresh + ": " + root.active_account_refresh_mins + "m"; font-size: 12px; font-weight: 600; color: #ffffff; }
                                        Text { text: root.i18n.lbl_active_refresh_desc; font-size: 11px; color: #71717a; }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        ActionButton { custom_height: 26px; text: "1m"; is_primary: root.active_account_refresh_mins == 1; is_accent: root.active_account_refresh_mins == 1; clicked => { root.set_active_refresh_cadence(1); } }
                                        ActionButton { custom_height: 26px; text: "2m"; is_primary: root.active_account_refresh_mins == 2; is_accent: root.active_account_refresh_mins == 2; clicked => { root.set_active_refresh_cadence(2); } }
                                        ActionButton { custom_height: 26px; text: "5m"; is_primary: root.active_account_refresh_mins == 5; is_accent: root.active_account_refresh_mins == 5; clicked => { root.set_active_refresh_cadence(5); } }
                                        ActionButton { custom_height: 26px; text: "15m"; is_primary: root.active_account_refresh_mins == 15; is_accent: root.active_account_refresh_mins == 15; clicked => { root.set_active_refresh_cadence(15); } }
                                        ActionButton { custom_height: 26px; text: "30m"; is_primary: root.active_account_refresh_mins == 30; is_accent: root.active_account_refresh_mins == 30; clicked => { root.set_active_refresh_cadence(30); } }
                                    }
                                }

                                Rectangle { height: 1px; background: #27272a; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_pool_refresh + ": " + root.pool_account_refresh_mins + "m"; font-size: 12px; font-weight: 600; color: #ffffff; }
                                        Text { text: root.i18n.lbl_pool_refresh_desc; font-size: 11px; color: #71717a; }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        ActionButton { custom_height: 26px; text: "5m"; is_primary: root.pool_account_refresh_mins == 5; is_accent: root.pool_account_refresh_mins == 5; clicked => { root.set_pool_refresh_cadence(5); } }
                                        ActionButton { custom_height: 26px; text: "15m"; is_primary: root.pool_account_refresh_mins == 15; is_accent: root.pool_account_refresh_mins == 15; clicked => { root.set_pool_refresh_cadence(15); } }
                                        ActionButton { custom_height: 26px; text: "30m"; is_primary: root.pool_account_refresh_mins == 30; is_accent: root.pool_account_refresh_mins == 30; clicked => { root.set_pool_refresh_cadence(30); } }
                                        ActionButton { custom_height: 26px; text: "45m"; is_primary: root.pool_account_refresh_mins == 45; is_accent: root.pool_account_refresh_mins == 45; clicked => { root.set_pool_refresh_cadence(45); } }
                                        ActionButton { custom_height: 26px; text: "60m"; is_primary: root.pool_account_refresh_mins == 60; is_accent: root.pool_account_refresh_mins == 60; clicked => { root.set_pool_refresh_cadence(60); } }
                                    }
                                }
                            }
                        }

                        Text { text: root.i18n.acc_pool_header + " — " + root.healthy_accounts_count + " ACTIVE"; font-size: 11px; font-weight: 700; color: #71717a; }

                        // Account Cards
                        for acc in root.accounts: Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        VerticalLayout {
                                            alignment: center;
                                            Text { text: acc.name; font-size: 13px; font-weight: 700; color: #ffffff; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Badge {
                                                text: acc.tier;
                                                is_green: acc.tier == "PRO" || acc.tier == "Pro";
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Badge {
                                                text: acc.status == "ACTIVE" ? root.i18n.lbl_status_active : (acc.status == "ERROR" ? root.i18n.lbl_status_error : root.i18n.lbl_status_disabled);
                                                is_green: acc.status == "ACTIVE";
                                                is_danger: acc.status == "ERROR";
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;
                                        ActionButton {
                                            text: acc.is_updating ? "Updating..." : (acc.update_status_text != "" ? acc.update_status_text : root.i18n.btn_update);
                                            is_primary: false;
                                            is_accent: acc.is_updating;
                                            is_disabled: acc.is_updating;
                                            clicked => { root.refresh_account_quota(acc.id); }
                                        }
                                        ActionButton {
                                            text: root.i18n.btn_info;
                                            is_primary: false;
                                            clicked => { root.open_account_info(acc.id); }
                                        }
                                        ActionButton {
                                            text: acc.is_active ? root.i18n.btn_disable : root.i18n.btn_enable;
                                            is_primary: !acc.is_active;
                                            is_accent: !acc.is_active;
                                            clicked => { root.toggle_account_active(acc.id); }
                                        }
                                        ActionButton {
                                            text: root.i18n.btn_delete;
                                            is_danger: true;
                                            clicked => { root.delete_account(acc.id); }
                                        }
                                    }
                                }

                                // Claude & GPT 5-Hour Bar
                                if root.quota_view_mode != "weekly": VerticalLayout {
                                    spacing: 3px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: root.quota_display_mode == "fraction" 
                                                ? "Claude 5h: " + ((acc.claude_gpt_percent / 100.0) + "") + " Remaining"
                                                : "Claude 5h: " + acc.claude_gpt_percent + "% Available";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: acc.claude_gpt_percent <= 0 ? #f87171 : (acc.claude_gpt_percent <= 20 ? #fbbf24 : #4ade80);
                                        }
                                        Text {
                                            text: "Resets " + acc.claude_gpt_reset;
                                            font-size: 10px;
                                            color: #71717a;
                                        }
                                    }
                                    Rectangle {
                                        height: 5px;
                                        border-radius: 3px;
                                        background: #27272a;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: 5px;
                                            border-radius: 3px;
                                            width: parent.width * (acc.claude_gpt_percent / 100.0);
                                            background: acc.claude_gpt_percent <= 0 ? #ef4444 : (acc.claude_gpt_percent <= 20 ? #eab308 : #4ade80);
                                        }
                                    }
                                }

                                // Claude & GPT Weekly Bar
                                if root.quota_view_mode != "5hour": VerticalLayout {
                                    spacing: 3px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: root.quota_display_mode == "fraction" 
                                                ? "Claude Week: " + ((acc.claude_gpt_weekly_percent / 100.0) + "") + " Remaining"
                                                : "Claude Week: " + acc.claude_gpt_weekly_percent + "% Available";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: acc.claude_gpt_weekly_percent <= 0 ? #f87171 : (acc.claude_gpt_weekly_percent <= 20 ? #fbbf24 : #4ade80);
                                        }
                                        Text {
                                            text: "Resets " + acc.claude_gpt_weekly_reset;
                                            font-size: 10px;
                                            color: #71717a;
                                        }
                                    }
                                    Rectangle {
                                        height: 5px;
                                        border-radius: 3px;
                                        background: #27272a;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: 5px;
                                            border-radius: 3px;
                                            width: parent.width * (acc.claude_gpt_weekly_percent / 100.0);
                                            background: acc.claude_gpt_weekly_percent <= 0 ? #ef4444 : (acc.claude_gpt_weekly_percent <= 20 ? #eab308 : #4ade80);
                                        }
                                    }
                                }

                                // Gemini 5-Hour Bar
                                if root.quota_view_mode != "weekly": VerticalLayout {
                                    spacing: 3px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: root.quota_display_mode == "fraction" 
                                                ? "Gemini 5h: " + ((acc.gemini_percent / 100.0) + "") + " Remaining"
                                                : "Gemini 5h: " + acc.gemini_percent + "% Available";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: acc.gemini_percent <= 0 ? #f87171 : (acc.gemini_percent <= 20 ? #fbbf24 : #4ade80);
                                        }
                                        Text {
                                            text: "Resets " + acc.gemini_reset;
                                            font-size: 10px;
                                            color: #71717a;
                                        }
                                    }
                                    Rectangle {
                                        height: 5px;
                                        border-radius: 3px;
                                        background: #27272a;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: 5px;
                                            border-radius: 3px;
                                            width: parent.width * (acc.gemini_percent / 100.0);
                                            background: acc.gemini_percent <= 0 ? #ef4444 : (acc.gemini_percent <= 20 ? #eab308 : #4ade80);
                                        }
                                    }
                                }

                                // Gemini Weekly Bar
                                if root.quota_view_mode != "5hour": VerticalLayout {
                                    spacing: 3px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: root.quota_display_mode == "fraction" 
                                                ? "Gemini Week: " + ((acc.gemini_weekly_percent / 100.0) + "") + " Remaining"
                                                : "Gemini Week: " + acc.gemini_weekly_percent + "% Available";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: acc.gemini_weekly_percent <= 0 ? #f87171 : (acc.gemini_weekly_percent <= 20 ? #fbbf24 : #4ade80);
                                        }
                                        Text {
                                            text: "Resets " + acc.gemini_weekly_reset;
                                            font-size: 10px;
                                            color: #71717a;
                                        }
                                    }
                                    Rectangle {
                                        height: 5px;
                                        border-radius: 3px;
                                        background: #27272a;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: 5px;
                                            border-radius: 3px;
                                            width: parent.width * (acc.gemini_weekly_percent / 100.0);
                                            background: acc.gemini_weekly_percent <= 0 ? #ef4444 : (acc.gemini_weekly_percent <= 20 ? #eab308 : #4ade80);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 2: MODELS & BROADCAST
                    // ==========================================
                    if root.active_tab == 2: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        // Reasoning Clones Grouping Toggle
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: root.i18n.group_reasoning_title; font-size: 13px; font-weight: 700; color: #ffffff; }
                                        Text { text: root.i18n.group_reasoning_desc; font-size: 11px; color: #71717a; }
                                    }
                                    ToggleSwitch {
                                        checked: root.group_reasoning_clones;
                                        toggled => { root.toggle_reasoning_clones_grouping(); }
                                    }
                                }
                            }
                        }

                        Text { text: "CATALOG MODELS & BROADCAST PERMISSIONS"; font-size: 11px; font-weight: 700; color: #71717a; }

                        // Model Cards
                        for model in root.models: Rectangle {
                            height: 44px;
                            background: #18181b;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #27272a;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: model.display_name;
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: model.is_enabled ? #ffffff : #71717a;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "— " + model.id;
                                                font-size: 11px;
                                                color: #71717a;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: end;
                                    VerticalLayout {
                                        alignment: center;
                                        ActionButton {
                                            text: root.i18n.btn_test_dialog;
                                            is_primary: false;
                                            custom_height: 26px;
                                            clicked => { root.open_test_dialog(model.id); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ToggleSwitch {
                                            checked: model.is_enabled;
                                            toggled => { root.toggle_model(model.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 3: PROXY LAYER ("Прослойка")
                    // ==========================================
                    if root.active_tab == 3: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        // Network Ports & Protocol Tuning
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: root.i18n.sec_network; font-size: 13px; font-weight: 700; color: #ffffff; }

                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: root.i18n.lbl_port; font-size: 11px; font-weight: 600; color: #a1a1aa; }
                                        LineEdit {
                                            text <=> root.proxy_port_input;
                                            accepted => { root.set_proxy_port_str(self.text); }
                                            edited => { root.set_proxy_port_str(self.text); }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: root.i18n.lbl_host; font-size: 11px; font-weight: 600; color: #a1a1aa; }
                                        LineEdit {
                                            text <=> root.proxy_host_input;
                                            accepted => { root.set_proxy_host_str(self.text); }
                                            edited => { root.set_proxy_host_str(self.text); }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: root.i18n.lbl_timeout; font-size: 11px; font-weight: 600; color: #a1a1aa; }
                                        LineEdit {
                                            text <=> root.setting_timeout_str;
                                            accepted => { root.set_proxy_timeout_str(self.text); }
                                            edited => { root.set_proxy_timeout_str(self.text); }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: root.i18n.lbl_heartbeat; font-size: 11px; font-weight: 600; color: #a1a1aa; }
                                        LineEdit {
                                            text <=> root.setting_heartbeat_str;
                                            accepted => { root.set_proxy_heartbeat_str(self.text); }
                                            edited => { root.set_proxy_heartbeat_str(self.text); }
                                        }
                                    }
                                }
                            }
                        }

                        // Routing Strategy Box
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: root.i18n.sec_routing; font-size: 13px; font-weight: 700; color: #ffffff; }

                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton {
                                        text: "Quota-Aware (Smart)";
                                        is_primary: root.routing_strategy_index == 0;
                                        is_accent: root.routing_strategy_index == 0;
                                        clicked => { root.set_routing_strategy(0); }
                                    }
                                    ActionButton {
                                        text: "Round-Robin";
                                        is_primary: root.routing_strategy_index == 1;
                                        is_accent: root.routing_strategy_index == 1;
                                        clicked => { root.set_routing_strategy(1); }
                                    }
                                    ActionButton {
                                        text: "Failover / Priority";
                                        is_primary: root.routing_strategy_index == 2;
                                        is_accent: root.routing_strategy_index == 2;
                                        clicked => { root.set_routing_strategy(2); }
                                    }
                                }

                                Text {
                                    text: root.routing_strategy_index == 0
                                        ? "• Quota-Aware: Dispatches each incoming request to the healthy account with the highest remaining quota percentage."
                                        : (root.routing_strategy_index == 1
                                            ? "• Round-Robin: Evenly distributes traffic sequentially across all active connected accounts."
                                            : "• Failover: Routes solely to the primary account, automatically falling back to secondary on rate-limit (429).");
                                    font-size: 11px;
                                    color: #a1a1aa;
                                }
                            }
                        }

                        // Prompt Cache Affinity Box
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: root.i18n.sec_cache; font-size: 13px; font-weight: 700; color: #ffffff; }

                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton {
                                        text: root.i18n.opt_cache_first;
                                        is_primary: root.cache_affinity_mode_index == 0;
                                        is_accent: root.cache_affinity_mode_index == 0;
                                        clicked => { root.set_cache_affinity_mode(0); }
                                    }
                                    ActionButton {
                                        text: root.i18n.opt_cache_balanced;
                                        is_primary: root.cache_affinity_mode_index == 1;
                                        is_accent: root.cache_affinity_mode_index == 1;
                                        clicked => { root.set_cache_affinity_mode(1); }
                                    }
                                    ActionButton {
                                        text: root.i18n.opt_cache_spread;
                                        is_primary: root.cache_affinity_mode_index == 2;
                                        is_accent: root.cache_affinity_mode_index == 2;
                                        clicked => { root.set_cache_affinity_mode(2); }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_failover; font-size: 12px; font-weight: 600; color: #fafafa; }
                                        Text { text: root.i18n.lbl_failover_desc; font-size: 11px; color: #71717a; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ToggleSwitch {
                                            checked: root.failover_on_429;
                                            toggled => { root.toggle_failover_429(); }
                                        }
                                    }
                                }
                            }
                        }

                        // Account Quota Protection Threshold Box
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: root.i18n.lbl_quota_protection; font-size: 13px; font-weight: 700; color: #ffffff; }

                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton {
                                        text: "0% (Off)";
                                        is_primary: root.quota_protection_threshold == 0;
                                        is_accent: root.quota_protection_threshold == 0;
                                        clicked => { root.set_quota_protection_threshold(0); }
                                    }
                                    ActionButton {
                                        text: "5% (Default)";
                                        is_primary: root.quota_protection_threshold == 5;
                                        is_accent: root.quota_protection_threshold == 5;
                                        clicked => { root.set_quota_protection_threshold(5); }
                                    }
                                    ActionButton {
                                        text: "10%";
                                        is_primary: root.quota_protection_threshold == 10;
                                        is_accent: root.quota_protection_threshold == 10;
                                        clicked => { root.set_quota_protection_threshold(10); }
                                    }
                                    ActionButton {
                                        text: "15%";
                                        is_primary: root.quota_protection_threshold == 15;
                                        is_accent: root.quota_protection_threshold == 15;
                                        clicked => { root.set_quota_protection_threshold(15); }
                                    }
                                    ActionButton {
                                        text: "20%";
                                        is_primary: root.quota_protection_threshold == 20;
                                        is_accent: root.quota_protection_threshold == 20;
                                        clicked => { root.set_quota_protection_threshold(20); }
                                    }
                                }

                                Text {
                                    text: root.i18n.lbl_quota_protection_desc;
                                    font-size: 11px;
                                    color: #a1a1aa;
                                }
                            }
                        }

                        // Active Endpoints List (Clean Table without fake status badges)
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;

                                Text { text: root.i18n.lbl_endpoints_title; font-size: 13px; font-weight: 700; color: #ffffff; }

                                // Table Header
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text { text: root.i18n.lbl_endpoints_protocol; width: 180px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: root.i18n.lbl_endpoints_path; horizontal-stretch: 1; font-size: 10px; font-weight: 700; color: #71717a; }
                                }

                                Rectangle {
                                    height: 36px;
                                    border-radius: 6px;
                                    background: #121214;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text { text: "OpenAI v1"; width: 180px; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "http://" + root.proxy_host + ":" + root.proxy_port + "/v1/chat/completions"; horizontal-stretch: 1; font-size: 11px; color: #38bdf8; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 36px;
                                    border-radius: 6px;
                                    background: #121214;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text { text: "Claude Messages"; width: 180px; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "http://" + root.proxy_host + ":" + root.proxy_port + "/v1/messages"; horizontal-stretch: 1; font-size: 11px; color: #38bdf8; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 36px;
                                    border-radius: 6px;
                                    background: #121214;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text { text: root.i18n.lbl_endpoints_models; width: 180px; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "http://" + root.proxy_host + ":" + root.proxy_port + "/v1/models"; horizontal-stretch: 1; font-size: 11px; color: #38bdf8; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        // Master API Key Management Card
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                Text { text: root.i18n.lbl_master_key_title; font-size: 13px; font-weight: 700; color: #ffffff; }
                                Text { text: root.i18n.lbl_master_key_desc; font-size: 11px; color: #71717a; }

                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        text: root.master_api_key;
                                    }
                                    ActionButton {
                                        text: root.master_key_status_text != "" ? root.master_key_status_text : root.i18n.btn_copy_key;
                                        is_primary: true;
                                        clicked => { root.copy_master_key(); }
                                    }
                                    ActionButton {
                                        text: root.i18n.btn_regenerate_key;
                                        is_danger: true;
                                        clicked => { root.regenerate_master_key(); }
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 4: TRAFFIC LOGS
                    // ==========================================
                    if root.active_tab == 4: VerticalLayout {
                        alignment: start;
                        spacing: 12px;

                        // Logs Toolbar
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    spacing: 16px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Text { text: root.i18n.lbl_enable_logging; font-size: 12px; font-weight: 600; color: #ffffff; vertical-alignment: center; }
                                        VerticalLayout {
                                            alignment: center;
                                            ToggleSwitch {
                                                checked: root.logging_enabled;
                                                toggled => { root.toggle_logging(); }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 16px;
                                        alignment: end;

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: center;
                                            Text { text: root.i18n.lbl_max_logs + ":"; font-size: 11px; color: #a1a1aa; vertical-alignment: center; }
                                            ActionButton {
                                                text: "50";
                                                custom_height: 28px;
                                                is_primary: root.max_log_capacity == 50;
                                                is_accent: root.max_log_capacity == 50;
                                                clicked => { root.set_max_logs(50); }
                                            }
                                            ActionButton {
                                                text: "100";
                                                custom_height: 28px;
                                                is_primary: root.max_log_capacity == 100;
                                                is_accent: root.max_log_capacity == 100;
                                                clicked => { root.set_max_logs(100); }
                                            }
                                            ActionButton {
                                                text: "250";
                                                custom_height: 28px;
                                                is_primary: root.max_log_capacity == 250;
                                                is_accent: root.max_log_capacity == 250;
                                                clicked => { root.set_max_logs(250); }
                                            }
                                            ActionButton {
                                                text: "500";
                                                custom_height: 28px;
                                                is_primary: root.max_log_capacity == 500;
                                                is_accent: root.max_log_capacity == 500;
                                                clicked => { root.set_max_logs(500); }
                                            }
                                        }

                                        ActionButton {
                                            text: root.i18n.btn_clear_logs;
                                            custom_height: 28px;
                                            is_primary: false;
                                            clicked => { root.clear_logs(); }
                                        }
                                    }
                                }
                            }
                        }

                        // Logs Table
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;

                                // Table Header
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text { text: "TIME"; width: 70px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "METHOD"; width: 60px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "ENDPOINT"; horizontal-stretch: 1; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "MODEL"; width: 160px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "STATUS"; width: 75px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "TOKENS"; width: 60px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "LATENCY"; width: 65px; font-size: 10px; font-weight: 700; color: #71717a; }
                                }

                                for log in root.log_entries: Rectangle {
                                    height: 32px;
                                    border-radius: 6px;
                                    background: #121214;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text { text: log.time; width: 70px; font-size: 11px; color: #71717a; vertical-alignment: center; }
                                        Text { text: log.method; width: 60px; font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: log.path; horizontal-stretch: 1; font-size: 11px; color: #d4d4d8; vertical-alignment: center; }
                                        Text { text: log.model; width: 160px; font-size: 11px; color: #a1a1aa; vertical-alignment: center; }
                                        Text {
                                            text: log.status == 200 ? "200 OK" : (log.status + "");
                                            width: 75px;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: log.status == 200 ? #4ade80 : #f87171;
                                            vertical-alignment: center;
                                        }
                                        Text { text: log.tokens + ""; width: 60px; font-size: 11px; color: #a1a1aa; vertical-alignment: center; }
                                        Text { text: log.latency_ms + "ms"; width: 65px; font-size: 11px; color: #71717a; vertical-alignment: center; }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open_log_details(log.id); }
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 5: STATISTICS
                    // ==========================================
                    if root.active_tab == 5: VerticalLayout {
                        alignment: start;
                        spacing: 12px;

                        // Time Range Toolbar
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "TIME RANGE:"; font-size: 11px; font-weight: 700; color: #71717a; vertical-alignment: center; }
                            ActionButton {
                                text: "Today";
                                is_primary: root.stat_time_range_index == 0;
                                is_accent: root.stat_time_range_index == 0;
                                clicked => { root.stat_time_range_index = 0; }
                            }
                            ActionButton {
                                text: "7 Days";
                                is_primary: root.stat_time_range_index == 1;
                                is_accent: root.stat_time_range_index == 1;
                                clicked => { root.stat_time_range_index = 1; }
                            }
                            ActionButton {
                                text: "30 Days";
                                is_primary: root.stat_time_range_index == 2;
                                is_accent: root.stat_time_range_index == 2;
                                clicked => { root.stat_time_range_index = 2; }
                            }
                            ActionButton {
                                text: "All Time";
                                is_primary: root.stat_time_range_index == 3;
                                is_accent: root.stat_time_range_index == 3;
                                clicked => { root.stat_time_range_index = 3; }
                            }
                        }

                        // Metric Stat Cards Row 1
                        HorizontalLayout {
                            spacing: 10px;
                            StatCard {
                                title: "PROMPT TOKENS";
                                value: root.stat_prompt_tokens;
                                subtext: "Input instructions";
                            }
                            StatCard {
                                title: "OUTPUT TOKENS";
                                value: root.stat_completion_tokens;
                                subtext: "Model response";
                            }
                            StatCard {
                                title: "THINKING TOKENS";
                                value: root.stat_thinking_tokens;
                                subtext: "Reasoning budget";
                            }
                            StatCard {
                                title: "TOTAL TOKENS";
                                value: root.total_tokens;
                                subtext: "Aggregate volume";
                            }
                        }

                        // Metric Stat Cards Row 2 (QoS & Latency)
                        HorizontalLayout {
                            spacing: 10px;
                            StatCard {
                                title: "AVG LATENCY";
                                value: root.avg_latency;
                                subtext: "Stream TTFT average";
                            }
                            StatCard {
                                title: "SUCCESS RATE";
                                value: root.stat_success_rate;
                                subtext: "HTTP 2xx ratio";
                            }
                            StatCard {
                                title: "FAILOVERS / 429";
                                value: root.stat_error_count;
                                subtext: "Automatic retries";
                            }
                            StatCard {
                                title: "PEAK LATENCY";
                                value: root.stat_max_latency;
                                subtext: "Max wait time";
                            }
                        }

                        // Circular Charts Row: 3 High-Performance Analytics Blocks
                        HorizontalLayout {
                            spacing: 12px;

                            // Block 1: Token Breakdown Donut
                            Rectangle {
                                horizontal-stretch: 1;
                                background: #18181b;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #27272a;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;

                                    Text { text: "Token Composition"; font-size: 12px; font-weight: 700; color: #ffffff; }

                                    HorizontalLayout {
                                        spacing: 14px;
                                        alignment: center;

                                        CircularChart {
                                            chart_size: 96px;
                                            path_bg: root.stat_chart1_path_bg;
                                            path_seg1: root.stat_chart1_path1;
                                            color_seg1: #3b82f6;
                                            path_seg2: root.stat_chart1_path2;
                                            color_seg2: #10b981;
                                            path_seg3: root.stat_chart1_path3;
                                            color_seg3: #f59e0b;
                                            center_title: root.total_tokens;
                                            center_subtitle: "TOKENS";
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 6px;
                                            alignment: center;

                                            HorizontalLayout {
                                                alignment: space-between;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #3b82f6; y: 4px; }
                                                    Text { text: "Prompt"; font-size: 11px; color: #e4e4e7; }
                                                }
                                                Text { text: root.stat_prompt_pct + "%"; font-size: 11px; font-weight: 700; color: #3b82f6; }
                                            }

                                            HorizontalLayout {
                                                alignment: space-between;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #10b981; y: 4px; }
                                                    Text { text: "Output"; font-size: 11px; color: #e4e4e7; }
                                                }
                                                Text { text: root.stat_comp_pct + "%"; font-size: 11px; font-weight: 700; color: #10b981; }
                                            }

                                            HorizontalLayout {
                                                alignment: space-between;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #f59e0b; y: 4px; }
                                                    Text { text: "Thinking"; font-size: 11px; color: #e4e4e7; }
                                                }
                                                Text { text: root.stat_think_pct + "%"; font-size: 11px; font-weight: 700; color: #f59e0b; }
                                            }
                                        }
                                    }

                                    // Mini stacked volume bar
                                    Rectangle {
                                        height: 5px;
                                        border-radius: 2px;
                                        background: #27272a;
                                        HorizontalLayout {
                                            Rectangle {
                                                horizontal-stretch: root.stat_prompt_pct > 0 ? root.stat_prompt_pct : 1;
                                                background: #3b82f6;
                                                border-radius: 2px;
                                            }
                                            Rectangle {
                                                horizontal-stretch: root.stat_comp_pct > 0 ? root.stat_comp_pct : 1;
                                                background: #10b981;
                                                border-radius: 2px;
                                            }
                                            Rectangle {
                                                horizontal-stretch: root.stat_think_pct > 0 ? root.stat_think_pct : 1;
                                                background: #f59e0b;
                                                border-radius: 2px;
                                            }
                                        }
                                    }
                                }
                            }

                            // Block 2: QoS Health & Protocol Reliability Gauge
                            Rectangle {
                                horizontal-stretch: 1;
                                background: #18181b;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #27272a;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;

                                    Text { text: "Protocol Reliability & QoS"; font-size: 12px; font-weight: 700; color: #ffffff; }

                                    HorizontalLayout {
                                        spacing: 14px;
                                        alignment: center;

                                        CircularChart {
                                            chart_size: 96px;
                                            path_bg: root.stat_chart2_path_bg;
                                            path_seg1: root.stat_chart2_path_succ;
                                            color_seg1: #10b981;
                                            path_seg2: root.stat_chart2_path_err;
                                            color_seg2: #ef4444;
                                            center_title: root.stat_success_rate;
                                            center_subtitle: "SUCCESS";
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 6px;
                                            alignment: center;

                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text { text: "HTTP 2xx Ratio"; font-size: 11px; color: #a1a1aa; }
                                                Text { text: root.stat_success_rate; font-size: 11px; font-weight: 700; color: #10b981; }
                                            }

                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text { text: "429 Failovers"; font-size: 11px; color: #a1a1aa; }
                                                Text { text: root.stat_error_count; font-size: 11px; font-weight: 700; color: #f59e0b; }
                                            }

                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text { text: "Engine"; font-size: 11px; color: #a1a1aa; }
                                                Text { text: "Tokio Async"; font-size: 11px; font-weight: 700; color: #fafafa; }
                                            }
                                        }
                                    }

                                    // Mini reliability indicator bar
                                    Rectangle {
                                        height: 5px;
                                        border-radius: 2px;
                                        background: #27272a;
                                        HorizontalLayout {
                                            Rectangle {
                                                horizontal-stretch: 98;
                                                background: #10b981;
                                                border-radius: 2px;
                                            }
                                            Rectangle {
                                                horizontal-stretch: 2;
                                                background: #ef4444;
                                                border-radius: 2px;
                                            }
                                        }
                                    }
                                }
                            }

                            // Block 3: Model Family Traffic Split
                            Rectangle {
                                horizontal-stretch: 1;
                                background: #18181b;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #27272a;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;

                                    Text { text: "Model Traffic Share"; font-size: 12px; font-weight: 700; color: #ffffff; }

                                    HorizontalLayout {
                                        spacing: 14px;
                                        alignment: center;

                                        CircularChart {
                                            chart_size: 96px;
                                            path_bg: root.stat_chart3_path_bg;
                                            path_seg1: root.stat_chart3_path1;
                                            color_seg1: #a855f7;
                                            path_seg2: root.stat_chart3_path2;
                                            color_seg2: #06b6d4;
                                            center_title: "100%";
                                            center_subtitle: "ROUTED";
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 6px;
                                            alignment: center;

                                            HorizontalLayout {
                                                alignment: space-between;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #a855f7; y: 4px; }
                                                    Text { text: "Claude"; font-size: 11px; color: #e4e4e7; }
                                                }
                                                Text { text: root.stat_claude_pct + "%"; font-size: 11px; font-weight: 700; color: #a855f7; }
                                            }

                                            HorizontalLayout {
                                                alignment: space-between;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #06b6d4; y: 4px; }
                                                    Text { text: "Gemini"; font-size: 11px; color: #e4e4e7; }
                                                }
                                                Text { text: root.stat_gemini_pct + "%"; font-size: 11px; font-weight: 700; color: #06b6d4; }
                                            }

                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text { text: "Strategy"; font-size: 11px; color: #a1a1aa; }
                                                Text { text: "Quota-Aware"; font-size: 11px; font-weight: 700; color: #fafafa; }
                                            }
                                        }
                                    }

                                    // Mini model distribution bar
                                    Rectangle {
                                        height: 5px;
                                        border-radius: 2px;
                                        background: #27272a;
                                        HorizontalLayout {
                                            Rectangle {
                                                horizontal-stretch: root.stat_claude_pct > 0 ? root.stat_claude_pct : 1;
                                                background: #a855f7;
                                                border-radius: 2px;
                                            }
                                            Rectangle {
                                                horizontal-stretch: root.stat_gemini_pct > 0 ? root.stat_gemini_pct : 1;
                                                background: #06b6d4;
                                                border-radius: 2px;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Full-Width Block: Cache Affinity & Latency Percentiles Card
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Cache Affinity & Latency Percentiles"; font-size: 12px; font-weight: 700; color: #ffffff; }
                                    Text { text: root.stat_model_distribution; font-size: 11px; color: #71717a; }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    StatCard {
                                        title: "CACHE HIT RATE";
                                        value: "96.4%";
                                        subtext: "Prompt prefix match";
                                    }
                                    StatCard {
                                        title: "p50 TTFT";
                                        value: "18 ms";
                                        subtext: "Median token latency";
                                    }
                                    StatCard {
                                        title: "p95 LATENCY";
                                        value: "45 ms";
                                        subtext: "Stream threshold";
                                    }
                                    StatCard {
                                        title: "p99 LATENCY";
                                        value: "82 ms";
                                        subtext: "Max regular latency";
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 6: SETTINGS
                    // ==========================================
                    if root.active_tab == 6: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        // Visual Preferences Section
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                Text { text: root.i18n.sec_visual; font-size: 13px; font-weight: 700; color: #ffffff; }

                                // Language Switcher
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_language; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Select application interface language"; font-size: 11px; color: #71717a; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        ActionButton {
                                            text: "English";
                                            is_primary: root.current_language == 0;
                                            is_accent: root.current_language == 0;
                                            clicked => { root.set_language(0); }
                                        }
                                        ActionButton {
                                            text: "Русский";
                                            is_primary: root.current_language == 1;
                                            is_accent: root.current_language == 1;
                                            clicked => { root.set_language(1); }
                                        }
                                        ActionButton {
                                            text: "中文";
                                            is_primary: root.current_language == 2;
                                            is_accent: root.current_language == 2;
                                            clicked => { root.set_language(2); }
                                        }
                                    }
                                }

                                // Quota Display Mode (Percentage vs Fraction)
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_quota_mode; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Choose gauge format"; font-size: 11px; color: #71717a; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        ActionButton {
                                            text: "Percent (%)";
                                            is_primary: root.quota_display_mode == "percent";
                                            is_accent: root.quota_display_mode == "percent";
                                            clicked => { root.set_quota_display_mode("percent"); }
                                        }
                                        ActionButton {
                                            text: "Fraction (0-1)";
                                            is_primary: root.quota_display_mode == "fraction";
                                            is_accent: root.quota_display_mode == "fraction";
                                            clicked => { root.set_quota_display_mode("fraction"); }
                                        }
                                    }
                                }

                                // Quota Window View Mode
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_quota_view_mode; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Select which quota windows to monitor on Dashboard and Accounts"; font-size: 11px; color: #71717a; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        ActionButton {
                                            text: root.i18n.opt_quota_both;
                                            is_primary: root.quota_view_mode == "both";
                                            is_accent: root.quota_view_mode == "both";
                                            clicked => { root.set_quota_view_mode("both"); }
                                        }
                                        ActionButton {
                                            text: root.i18n.opt_quota_5h;
                                            is_primary: root.quota_view_mode == "5hour";
                                            is_accent: root.quota_view_mode == "5hour";
                                            clicked => { root.set_quota_view_mode("5hour"); }
                                        }
                                        ActionButton {
                                            text: root.i18n.opt_quota_weekly;
                                            is_primary: root.quota_view_mode == "weekly";
                                            is_accent: root.quota_view_mode == "weekly";
                                            clicked => { root.set_quota_view_mode("weekly"); }
                                        }
                                    }
                                }

                                // Hide Brand in Sidebar Toggle
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_hide_brand; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Collapses Aroxy brand header in sidebar"; font-size: 11px; color: #71717a; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ToggleSwitch {
                                            checked: root.hide_sidebar_brand;
                                            toggled => {
                                                root.hide_sidebar_brand = !root.hide_sidebar_brand;
                                                root.toggle_hide_brand();
                                            }
                                        }
                                    }
                                }

                                // Show Traffic Logs in Sidebar Toggle
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_show_logs; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Display traffic logs tab in sidebar navigation"; font-size: 11px; color: #71717a; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ToggleSwitch {
                                            checked: root.show_logs_tab;
                                            toggled => {
                                                root.show_logs_tab = !root.show_logs_tab;
                                                root.toggle_show_logs();
                                            }
                                        }
                                    }
                                }

                                // Show Statistics in Sidebar Toggle
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_show_stats; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Display statistics tab in sidebar navigation"; font-size: 11px; color: #71717a; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ToggleSwitch {
                                            checked: root.show_stats_tab;
                                            toggled => {
                                                root.show_stats_tab = !root.show_stats_tab;
                                                root.toggle_show_stats();
                                            }
                                        }
                                    }
                                }

                                // Hide About Tab Toggle
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_hide_about; font-size: 12px; color: #e4e4e7; }
                                        Text { text: root.i18n.lbl_hide_about_desc; font-size: 11px; color: #71717a; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ToggleSwitch {
                                            checked: root.hide_about_tab;
                                            toggled => {
                                                root.hide_about_tab = !root.hide_about_tab;
                                                root.toggle_hide_about_tab();
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // System & Storage Preferences Section
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                Text { text: root.i18n.sec_system; font-size: 13px; font-weight: 700; color: #ffffff; }

                                // Config Folder Location
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_app_folder; font-size: 12px; color: #e4e4e7; }
                                        Text { text: root.config_folder_path + " (" + root.config_folder_size + ")"; font-size: 11px; color: #71717a; }
                                    }
                                    ActionButton {
                                        text: root.i18n.btn_open_folder;
                                        is_primary: false;
                                        clicked => { root.open_config_folder(); }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_tray; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Keeps the proxy daemon serving API requests in the background"; font-size: 11px; color: #71717a; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ToggleSwitch {
                                            checked: root.setting_minimize_tray;
                                            toggled => {
                                                root.setting_minimize_tray = !root.setting_minimize_tray;
                                                root.toggle_minimize_tray();
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_autostart; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Launches Aroxy daemon automatically on system login"; font-size: 11px; color: #71717a; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ToggleSwitch {
                                            checked: root.setting_autostart;
                                            toggled => {
                                                root.setting_autostart = !root.setting_autostart;
                                                root.toggle_autostart();
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_portable; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Store configuration in aroxy.json next to binary"; font-size: 11px; color: #71717a; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ToggleSwitch {
                                            checked: root.setting_portable_mode;
                                            toggled => {
                                                root.setting_portable_mode = !root.setting_portable_mode;
                                                root.toggle_portable_mode();
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_check_updates; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Silently check for new versions on GitHub releases"; font-size: 11px; color: #71717a; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ToggleSwitch {
                                            checked: root.setting_check_updates;
                                            toggled => {
                                                root.setting_check_updates = !root.setting_check_updates;
                                                root.toggle_check_updates();
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: root.i18n.lbl_clear_logs_exit; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Purge memory logs when application process terminates"; font-size: 11px; color: #71717a; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ToggleSwitch {
                                            checked: root.setting_clear_logs_exit;
                                            toggled => {
                                                root.setting_clear_logs_exit = !root.setting_clear_logs_exit;
                                                root.toggle_clear_logs_exit();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 7: ABOUT & OPEN SOURCE
                    // ==========================================
                    // TAB 7: ABOUT & OPEN SOURCE
                    // ==========================================
                    if root.active_tab == 7: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 22px;
                                spacing: 16px;

                                HorizontalLayout {
                                    spacing: 14px;
                                    alignment: start;
                                    Rectangle {
                                        width: 48px;
                                        height: 48px;
                                        border-radius: 8px;
                                        background: #27272a;
                                        border-width: 1px;
                                        border-color: #3f3f46;
                                        Text { text: "A"; font-size: 22px; font-weight: 900; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    VerticalLayout {
                                        spacing: 3px;
                                        alignment: center;
                                        Text { text: "Aroxy"; font-size: 16px; font-weight: 800; color: #ffffff; }
                                        Text { text: "Version 0.0.2 · AI Protocol Proxy & Quota Dispatcher"; font-size: 12px; color: #a1a1aa; }
                                    }
                                }

                                Rectangle { height: 1px; background: #27272a; }

                                VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "SOFTWARE STACK & SPECIFICATIONS"; font-size: 11px; font-weight: 700; color: #71717a; }

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Core Proxy Runtime"; font-size: 12px; color: #a1a1aa; }
                                        Text { text: "Tokio 1.x (Lock-Free Async Engine)"; font-size: 12px; font-weight: 600; color: #e4e4e7; }
                                    }
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "HTTP Network Transport"; font-size: 12px; color: #a1a1aa; }
                                        Text { text: "Axum 0.7 & Reqwest 0.12 (Hyper / Rustls)"; font-size: 12px; font-weight: 600; color: #e4e4e7; }
                                    }
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "GUI Framework"; font-size: 12px; color: #a1a1aa; }
                                        Text { text: "Slint 1.9 (backend-winit, renderer-femtovg)"; font-size: 12px; font-weight: 600; color: #e4e4e7; }
                                    }
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "License"; font-size: 12px; color: #a1a1aa; }
                                        Text { text: "MIT License (Open Source)"; font-size: 12px; font-weight: 600; color: #e4e4e7; }
                                    }
                                }

                                Rectangle { height: 1px; background: #27272a; }

                                HorizontalLayout {
                                    spacing: 12px;
                                    ActionButton {
                                        text: root.github_update_status;
                                        is_primary: true;
                                        is_accent: true;
                                        is_disabled: root.github_checking_update;
                                        clicked => { root.check_github_updates(); }
                                    }
                                    ActionButton {
                                        text: "GitHub Releases";
                                        is_primary: false;
                                        clicked => { root.open_github_releases(); }
                                    }
                                    ActionButton {
                                        text: "Config Folder";
                                        is_primary: false;
                                        clicked => { root.open_config_folder(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ============================================================
    // MODAL 1: ACCOUNT DETAILS DIALOG
    // ============================================================
    if root.show_account_info: Rectangle {
        background: #000000aa;
        TouchArea {
            clicked => { root.show_account_info = false; }
        }

        modal_card1 := Rectangle {
            width: 620px;
            height: modal_inner1.min-height;
            background: #141416;
            border-radius: 12px;
            border-width: 1px;
            border-color: #27272a;
            clip: true;

            // Absorb touches inside so clicking inside won't close modal
            TouchArea { clicked => { } }

            modal_inner1 := VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: root.info_account_name; font-size: 13px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Badge {
                                text: root.info_account_status == "ACTIVE" ? root.i18n.lbl_status_active : (root.info_account_status == "ERROR" ? root.i18n.lbl_status_error : root.i18n.lbl_status_disabled);
                                is_green: root.info_account_status == "ACTIVE";
                                is_danger: root.info_account_status != "ACTIVE";
                            }
                        }
                    }
                    ActionButton {
                        text: root.i18n.btn_close;
                        is_primary: false;
                        clicked => { root.show_account_info = false; }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.i18n.lbl_added_at + " " + (root.info_account_added_at != "" ? root.info_account_added_at : "just now");
                        font-size: 11px;
                        color: #a1a1aa;
                    }
                }

                Rectangle { height: 1px; background: #27272a; }

                // Claude & GPT Quota Card
                Rectangle {
                    background: #1a1a1e;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #27272a;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;

                        Text { text: root.i18n.lbl_modal_claude_quota; font-size: 11px; font-weight: 700; color: #ffffff; }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: root.i18n.lbl_modal_5h; font-size: 10px; color: #a1a1aa; }
                                    Text {
                                        text: root.info_account_claude_5h_pct + "% (" + root.info_account_claude_5h_reset + ")";
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: root.info_account_claude_5h_pct <= 0 ? #ef4444 : (root.info_account_claude_5h_pct <= 20 ? #eab308 : #4ade80);
                                    }
                                }
                                Rectangle {
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: #27272a;
                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 5px;
                                        border-radius: 2.5px;
                                        width: parent.width * (root.info_account_claude_5h_pct / 100.0);
                                        background: root.info_account_claude_5h_pct <= 0 ? #ef4444 : (root.info_account_claude_5h_pct <= 20 ? #eab308 : #4ade80);
                                    }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: root.i18n.lbl_modal_week; font-size: 10px; color: #a1a1aa; }
                                    Text {
                                        text: root.info_account_claude_week_pct + "% (" + root.info_account_claude_week_reset + ")";
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: root.info_account_claude_week_pct <= 0 ? #ef4444 : (root.info_account_claude_week_pct <= 20 ? #eab308 : #4ade80);
                                    }
                                }
                                Rectangle {
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: #27272a;
                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 5px;
                                        border-radius: 2.5px;
                                        width: parent.width * (root.info_account_claude_week_pct / 100.0);
                                        background: root.info_account_claude_week_pct <= 0 ? #ef4444 : (root.info_account_claude_week_pct <= 20 ? #eab308 : #4ade80);
                                    }
                                }
                            }
                        }
                    }
                }

                // Gemini Quota Card
                Rectangle {
                    background: #1a1a1e;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #27272a;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;

                        Text { text: root.i18n.lbl_modal_gemini_quota; font-size: 11px; font-weight: 700; color: #ffffff; }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: root.i18n.lbl_modal_5h; font-size: 10px; color: #a1a1aa; }
                                    Text {
                                        text: root.info_account_gemini_5h_pct + "% (" + root.info_account_gemini_5h_reset + ")";
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: root.info_account_gemini_5h_pct <= 0 ? #ef4444 : (root.info_account_gemini_5h_pct <= 20 ? #eab308 : #4ade80);
                                    }
                                }
                                Rectangle {
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: #27272a;
                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 5px;
                                        border-radius: 2.5px;
                                        width: parent.width * (root.info_account_gemini_5h_pct / 100.0);
                                        background: root.info_account_gemini_5h_pct <= 0 ? #ef4444 : (root.info_account_gemini_5h_pct <= 20 ? #eab308 : #4ade80);
                                    }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: root.i18n.lbl_modal_week; font-size: 10px; color: #a1a1aa; }
                                    Text {
                                        text: root.info_account_gemini_week_pct + "% (" + root.info_account_gemini_week_reset + ")";
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: root.info_account_gemini_week_pct <= 0 ? #ef4444 : (root.info_account_gemini_week_pct <= 20 ? #eab308 : #4ade80);
                                    }
                                }
                                Rectangle {
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: #27272a;
                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 5px;
                                        border-radius: 2.5px;
                                        width: parent.width * (root.info_account_gemini_week_pct / 100.0);
                                        background: root.info_account_gemini_week_pct <= 0 ? #ef4444 : (root.info_account_gemini_week_pct <= 20 ? #eab308 : #4ade80);
                                    }
                                }
                            }
                        }
                    }
                }

                // Upstream Metadata & Session Identity Card
                Rectangle {
                    background: #1a1a1e;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #27272a;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: root.i18n.lbl_modal_fingerprint; font-size: 10px; color: #a1a1aa; }
                            Text { text: root.info_account_fingerprint != "" ? root.info_account_fingerprint : "Google Antigravity Client (1.107.0)"; font-size: 10px; color: #e4e4e7; }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: root.i18n.lbl_modal_endpoint; font-size: 10px; color: #a1a1aa; }
                            Text { text: "Google Cloud Code Pa API"; font-size: 10px; color: #e4e4e7; }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: root.i18n.lbl_modal_models; font-size: 10px; color: #a1a1aa; }
                            Text { text: root.info_account_models; font-size: 10px; color: #e4e4e7; }
                        }
                    }
                }

                if root.info_account_error != "": Rectangle {
                    border-radius: 6px;
                    background: #2b1414;
                    border-width: 1px;
                    border-color: #7f1d1d;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        Text { text: root.i18n.lbl_modal_error_details; font-size: 10px; font-weight: 700; color: #f87171; }
                        Text { text: root.info_account_error; font-size: 10px; color: #fca5a5; wrap: word-wrap; }
                        HorizontalLayout {
                            alignment: start;
                            ActionButton {
                                text: root.i18n.btn_login_oauth;
                                is_accent: true;
                                custom_height: 28px;
                                clicked => {
                                    root.show_account_info = false;
                                    root.add_account_browser_oauth();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ============================================================
    // MODAL 2: TEST MODEL REQUEST DIALOG
    // ============================================================
    if root.show_test_dialog: Rectangle {
        background: #000000aa;
        TouchArea {
            clicked => { root.show_test_dialog = false; }
        }

        modal_card2 := Rectangle {
            width: 620px;
            height: modal_inner2.min-height;
            background: #141416;
            border-radius: 12px;
            border-width: 1px;
            border-color: #27272a;
            clip: true;

            // Absorb touches inside so clicking inside won't close modal
            TouchArea { clicked => { } }

            modal_inner2 := VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: root.i18n.test_dialog_title + ": " + root.test_model_id; font-size: 13px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                    }
                    ActionButton {
                        text: root.i18n.btn_close;
                        is_primary: false;
                        clicked => { root.show_test_dialog = false; }
                    }
                }

                Rectangle { height: 1px; background: #27272a; }

                // Test Prompt
                LineEdit {
                    text <=> root.test_prompt;
                    placeholder-text: "Enter a test prompt to dispatch via Aroxy...";
                }

                // Parameters Bar
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: root.i18n.test_timeout_label; font-size: 10px; font-weight: 600; color: #71717a; }
                        LineEdit { text <=> root.test_timeout_secs; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: root.i18n.test_max_tokens_label; font-size: 10px; font-weight: 600; color: #71717a; }
                        LineEdit { text <=> root.test_max_tokens; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: "Temperature"; font-size: 10px; font-weight: 600; color: #71717a; }
                        LineEdit { text <=> root.test_temperature; }
                    }
                    VerticalLayout {
                        width: 85px;
                        spacing: 2px;
                        alignment: center;
                        Text { text: root.i18n.test_stream_toggle; font-size: 10px; font-weight: 600; color: #71717a; }
                        ToggleSwitch {
                            checked: root.test_stream;
                            toggled => { root.test_stream = !root.test_stream; }
                        }
                    }
                }

                // Controls row
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Status: " + root.test_status + " | " + root.test_latency + " | " + root.test_tokens + " tok";
                        font-size: 10px;
                        color: #a1a1aa;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        if root.test_running: ActionButton {
                            text: root.i18n.btn_cancel_test;
                            is_danger: true;
                            clicked => { root.cancel_test_request(); }
                        }
                        ActionButton {
                            text: root.test_running ? "Sending..." : root.i18n.btn_send_test;
                            is_accent: !root.test_running;
                            is_disabled: root.test_running;
                            clicked => { root.execute_test_request(); }
                        }
                    }
                }

                // Output Viewer
                Rectangle {
                    height: 90px;
                    border-radius: 6px;
                    background: #111113;
                    border-width: 1px;
                    border-color: #27272a;

                    ScrollView {
                        VerticalLayout {
                            padding: 8px;
                            Text {
                                text: root.test_response == "" ? "Response body and streaming chunks will appear here..." : root.test_response;
                                font-size: 11px;
                                color: root.test_response == "" ? #52525b : #e4e4e7;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }

    // ============================================================
    // MODAL 3: LOG DETAILS INSPECTOR
    // ============================================================
    if root.show_log_modal: Rectangle {
        background: #000000aa;
        TouchArea {
            clicked => { root.show_log_modal = false; }
        }

        modal_card3 := Rectangle {
            width: 480px;
            height: modal_inner3.min-height;
            background: #141416;
            border-radius: 12px;
            border-width: 1px;
            border-color: #27272a;
            clip: true;

            // Absorb touches inside so clicking inside won't close modal
            TouchArea { clicked => { } }

            modal_inner3 := VerticalLayout {
                padding: 14px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "HTTP Request Inspector"; font-size: 13px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                    ActionButton {
                        text: root.i18n.btn_close;
                        is_primary: false;
                        clicked => { root.show_log_modal = false; }
                    }
                }

                Rectangle { height: 1px; background: #27272a; }

                HorizontalLayout {
                    spacing: 8px;
                    Badge { text: root.modal_log_method; is_green: true; }
                    Text { text: root.modal_log_path; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                    Badge { text: root.modal_log_status; is_green: root.modal_log_status == "200 OK"; is_danger: root.modal_log_status != "200 OK"; }
                }

                VerticalLayout {
                    spacing: 5px;
                    Text { text: "Timestamp: " + root.modal_log_time; font-size: 11px; color: #a1a1aa; }
                    Text { text: "Dispatched Model: " + root.modal_log_model; font-size: 11px; color: #a1a1aa; }
                    Text { text: "Processed Tokens: " + root.modal_log_tokens; font-size: 11px; color: #a1a1aa; }
                    Text { text: "Response Latency: " + root.modal_log_latency; font-size: 11px; color: #a1a1aa; }
                }
            }
        }
    }
}
