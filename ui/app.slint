import { ScrollView, LineEdit } from "std-widgets.slint";
import "./fonts/Unbounded.ttf";

export struct LogEntryData {
    id: string,
    time: string,
    method: string,
    path: string,
    model: string,
    status: int,
    tokens: int,
    latency_ms: int,
}

export struct AccountData {
    id: string,
    name: string,
    provider: string,
    base_url: string,
    api_key_masked: string,
    fingerprint: string,
    tier: string,
    quota_used: int,
    quota_limit: int,
    quota_percent: int,
    quota_reset: string,
    claude_gpt_percent: int,
    claude_gpt_reset: string,
    gemini_percent: int,
    gemini_reset: string,
    status: string,
    is_active: bool,
}

export struct ModelItemData {
    id: string,
    display_name: string,
    provider: string,
    tier: string,
    is_enabled: bool,
    supports_thinking: bool,
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> is_active: false;
    callback clicked;

    height: 38px;
    border-radius: 6px;
    background: root.is_active ? #27272a : (touch.has-hover ? #18181b : transparent);
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: start;

        Text {
            text: root.text;
            font-size: 13px;
            font-weight: root.is_active ? 700 : 500;
            color: root.is_active ? #fafafa : (touch.has-hover ? #e4e4e7 : #a1a1aa);
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> is_primary: true;
    in property <bool> is_danger: false;
    in property <bool> is_accent: false;
    callback clicked;

    height: 32px;
    border-radius: 6px;
    background: root.is_danger 
        ? (touch.pressed ? #5f1515 : (touch.has-hover ? #7f1d1d : #451010))
        : (root.is_accent
            ? (touch.pressed ? #e4e4e7 : (touch.has-hover ? #ffffff : #f4f4f5))
            : (root.is_primary 
                ? (touch.pressed ? #323236 : (touch.has-hover ? #3f3f46 : #27272a))
                : (touch.pressed ? #121214 : (touch.has-hover ? #202023 : #18181b))));
    border-width: 1px;
    border-color: root.is_danger ? #991b1b : (root.is_accent ? #ffffff : #3f3f46);
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 700;
            color: root.is_danger ? #fca5a5 : (root.is_accent ? #09090b : #fafafa);
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled;

    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? #f4f4f5 : #27272a;
    border-width: 1px;
    border-color: #3f3f46;
    animate background { duration: 150ms; }

    Rectangle {
        x: root.checked ? 22px : 3px;
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.checked ? #09090b : #71717a;
        animate x { duration: 150ms; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component StatCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> subtext;

    background: #18181b;
    border-radius: 8px;
    border-width: 1px;
    border-color: #27272a;

    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        alignment: space-between;

        Text {
            text: root.title;
            font-size: 10px;
            font-weight: 700;
            color: #71717a;
            letter-spacing: 0.5px;
        }
        Text {
            text: root.value;
            font-size: 22px;
            font-weight: 800;
            color: #fafafa;
        }
        Text {
            text: root.subtext;
            font-size: 11px;
            color: #a1a1aa;
        }
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <bool> is_green: false;
    in property <bool> is_amber: false;
    in property <bool> is_danger: false;

    height: 20px;
    border-radius: 4px;
    background: root.is_green ? #14281e : (root.is_amber ? #291c10 : (root.is_danger ? #291212 : #27272a));
    border-width: 1px;
    border-color: root.is_green ? #1e4a34 : (root.is_amber ? #4e3518 : (root.is_danger ? #4a1c1c : #3f3f46));

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 10px;
            font-weight: 700;
            color: root.is_green ? #4ade80 : (root.is_amber ? #fbbf24 : (root.is_danger ? #f87171 : #d4d4d8));
            vertical-alignment: center;
        }
    }
}

export component MainWindow inherits Window {
    title: "Aroxy";
    default-font-family: "Unbounded";
    min-width: 960px;
    min-height: 620px;
    preferred-width: 1060px;
    preferred-height: 720px;
    background: #09090b;

    // Navigation & Status
    in-out property <int> active_tab: 0;
    in-out property <bool> proxy_running: false;
    in-out property <int> proxy_port: 8045;
    in-out property <string> proxy_host: "127.0.0.1";
    in-out property <string> active_model: "claude-3-7-sonnet";
    in-out property <bool> expose_reasoning_variants: true;

    // Dashboard Overview Metrics
    in-out property <string> total_requests: "0";
    in-out property <string> total_tokens: "0";
    in-out property <string> avg_latency: "0 ms";
    in-out property <string> active_account_name: "Antigravity Pool";
    in-out property <int> global_claude_percent: 100;
    in-out property <string> global_claude_reset: "in 4h 00m";
    in-out property <int> global_gemini_percent: 100;
    in-out property <string> global_gemini_reset: "in 4h 00m";
    in-out property <string> global_quota_used: "0";
    in-out property <string> global_quota_limit: "100,000";
    in-out property <int> global_quota_percent: 0;
    in-out property <string> global_quota_reset: "in 4h 00m";
    in-out property <int> healthy_accounts_count: 0;

    // Lists
    in-out property <[LogEntryData]> log_entries: [];
    in-out property <[AccountData]> accounts: [];
    in-out property <[ModelItemData]> models: [];

    // Account Form - Single Token Input (No manual name input!)
    in-out property <string> new_acc_token: "";

    // Account Details Dialog
    in-out property <bool> show_account_info: false;
    in-out property <string> info_account_name: "";
    in-out property <string> info_account_tier: "";
    in-out property <string> info_account_quota: "";
    in-out property <string> info_account_models: "";

    // Playground
    in-out property <string> playground_prompt: "Write a high-performance Rust function to calculate SHA-256.";
    in-out property <string> playground_model: "claude-3-7-sonnet";
    in-out property <string> playground_status: "Idle";
    in-out property <string> playground_latency: "0 ms";
    in-out property <string> playground_tokens: "0";
    in-out property <string> playground_response: "";
    in-out property <bool> playground_running: false;

    // Proxy Layer & Cache Balancer
    in-out property <int> routing_strategy_index: 0;
    in-out property <int> quota_refresh_interval: 300;
    in-out property <int> cache_affinity_mode_index: 1; // 0: CacheFirst, 1: Balanced, 2: AggressiveSpread
    in-out property <int> session_sticky_ttl_secs: 900;
    in-out property <int> quota_imbalance_threshold: 25;
    in-out property <bool> failover_on_429: true;
    in-out property <string> balancer_hit_rate: "100.0%";
    in-out property <int> balancer_active_sessions: 0;
    in-out property <int> balancer_failover_count: 0;

    // Statistics Detailed
    in-out property <string> stat_prompt_tokens: "0";
    in-out property <string> stat_completion_tokens: "0";
    in-out property <string> stat_thinking_tokens: "0";
    in-out property <string> stat_success_rate: "100%";
    in-out property <string> stat_error_count: "0";
    in-out property <string> stat_max_latency: "0 ms";

    // Settings
    in-out property <bool> setting_minimize_tray: true;
    in-out property <bool> setting_autostart: false;
    in-out property <bool> setting_portable_mode: false;
    in-out property <int> setting_timeout_secs: 120;
    in-out property <int> setting_heartbeat_secs: 12;
    in-out property <string> setting_fingerprint: "Claude Code 2.x";

    // Callbacks
    callback toggle_proxy();
    callback clear_logs();
    callback add_account();
    callback add_account_browser_oauth();
    callback delete_account(string);
    callback refresh_account_quota(string);
    callback show_account_details(string);
    callback toggle_model(string);
    callback toggle_reasoning_variants();
    callback set_routing_strategy(int);
    callback set_cache_affinity_mode(int);
    callback set_session_ttl(int);
    callback set_imbalance_threshold(int);
    callback toggle_failover_429();
    callback run_playground_test();
    callback save_settings();

    HorizontalLayout {
        // Left Navigation Sidebar (Clean Monocrome Charcoal)
        Rectangle {
            width: 200px;
            background: #111113;
            border-width: 0px;

            VerticalLayout {
                padding: 14px;
                spacing: 4px;

                // App Brand
                HorizontalLayout {
                    padding-bottom: 16px;
                    padding-left: 8px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Aroxy";
                        font-size: 16px;
                        font-weight: 800;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "v0.0.2";
                        font-size: 11px;
                        font-weight: 600;
                        color: #71717a;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 4px; }

                // Clean Navigation Tabs (No Emojis!)
                NavItem {
                    text: "Dashboard";
                    is_active: root.active_tab == 0;
                    clicked => { root.active_tab = 0; }
                }
                NavItem {
                    text: "Accounts";
                    is_active: root.active_tab == 1;
                    clicked => { root.active_tab = 1; }
                }
                NavItem {
                    text: "Models & Test";
                    is_active: root.active_tab == 2;
                    clicked => { root.active_tab = 2; }
                }
                NavItem {
                    text: "Proxy Layer";
                    is_active: root.active_tab == 3;
                    clicked => { root.active_tab = 3; }
                }
                NavItem {
                    text: "Traffic Logs";
                    is_active: root.active_tab == 4;
                    clicked => { root.active_tab = 4; }
                }
                NavItem {
                    text: "Statistics";
                    is_active: root.active_tab == 5;
                    clicked => { root.active_tab = 5; }
                }
                NavItem {
                    text: "Settings";
                    is_active: root.active_tab == 6;
                    clicked => { root.active_tab = 6; }
                }

                // Flexible Spacer
                Rectangle { }
            }
        }

        // Main Content Area
        VerticalLayout {
            padding: 20px;
            spacing: 16px;

            // Top Header Bar
            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: root.active_tab == 0 ? "Dashboard & Overview"
                            : root.active_tab == 1 ? "Upstream Accounts & Quota Balances"
                            : root.active_tab == 2 ? "Model Catalog & Test Playground"
                            : root.active_tab == 3 ? "Proxy Routing & Protocol Gateways"
                            : root.active_tab == 4 ? "Real-time Traffic & Stream Inspector"
                            : root.active_tab == 5 ? "Telemetry Analytics & Token Distribution"
                            : "Application & System Preferences";
                        font-size: 18px;
                        font-weight: 800;
                        color: #ffffff;
                    }
                    Text {
                        text: root.active_tab == 0 ? "Aggregate quota health, active proxy state, and client bindings"
                            : root.active_tab == 1 ? "Pooled Antigravity accounts with automatic email parsing and quota tracking"
                            : root.active_tab == 2 ? "Configure model broadcast toggles, reasoning aliases, and test prompts"
                            : root.active_tab == 3 ? "Configure smart quota routing, account rotation, and listening ports"
                            : root.active_tab == 4 ? "Inspect live HTTP streams, headers, latency percentiles, and errors"
                            : root.active_tab == 5 ? "Deep insight into prompt, completion, and reasoning token consumption"
                            : "System tray behaviors, portable config, and network timeouts";
                        font-size: 11px;
                        color: #71717a;
                    }
                }

                HorizontalLayout {
                    spacing: 14px;
                    alignment: end;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 4px;
                                background: root.proxy_running ? #4ade80 : #f87171;
                            }
                        }
                        Text {
                            text: root.proxy_running ? (":" + root.proxy_port + " Active") : "Stopped";
                            font-size: 12px;
                            font-weight: 600;
                            color: root.proxy_running ? #4ade80 : #71717a;
                            vertical-alignment: center;
                        }
                    }

                    ActionButton {
                        text: root.proxy_running ? "STOP PROXY" : "START PROXY";
                        is_primary: !root.proxy_running;
                        is_danger: root.proxy_running;
                        is_accent: !root.proxy_running;
                        clicked => { root.toggle_proxy(); }
                    }
                }
            }

            // Scrollable Content Container (Smooth scrolling, zero clipping, no stretching)
            ScrollView {
                VerticalLayout {
                    alignment: start;
                    padding-right: 8px;
                    spacing: 16px;

                    // ==========================================
                    // TAB 0: DASHBOARD
                    // ==========================================
                    if root.active_tab == 0: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        // Quick Stat Cards
                        HorizontalLayout {
                            spacing: 12px;
                            StatCard {
                                title: "TOTAL REQUESTS";
                                value: root.total_requests;
                                subtext: "Processed API calls";
                            }
                            StatCard {
                                title: "TOTAL TOKENS";
                                value: root.total_tokens;
                                subtext: "Prompt + Output + Thinking";
                            }
                            StatCard {
                                title: "AVG LATENCY";
                                value: root.avg_latency;
                                subtext: "Time to first token (TTFT)";
                            }
                            StatCard {
                                title: "POOLED ACCOUNTS";
                                value: root.healthy_accounts_count + "";
                                subtext: "Active in routing pool";
                            }
                        }

                        // Claude & GPT Models Quota Card
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Claude & GPT Quota Pool"; font-size: 13px; font-weight: 700; color: #ffffff; }
                                        Text { text: "Shared 5-hour rolling & weekly capacity (Claude 3.7 / 3.5 Sonnet, GPT-OSS)"; font-size: 11px; color: #71717a; }
                                    }
                                    Badge {
                                        text: "Resets " + root.global_claude_reset;
                                        is_green: root.global_claude_percent > 20;
                                        is_danger: root.global_claude_percent <= 20;
                                    }
                                }

                                // Progress Bar Container
                                Rectangle {
                                    height: 8px;
                                    border-radius: 4px;
                                    background: #27272a;

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 8px;
                                        border-radius: 4px;
                                        width: parent.width * (root.global_claude_percent / 100.0);
                                        background: root.global_claude_percent < 20 ? #ef4444 : (root.global_claude_percent < 50 ? #fbbf24 : #4ade80);
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: root.global_claude_percent + "% Available Capacity";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: root.global_claude_percent < 20 ? #f87171 : (root.global_claude_percent < 50 ? #fbbf24 : #4ade80);
                                    }
                                    Text {
                                        text: "Routing: Cache Affinity Pool";
                                        font-size: 11px;
                                        color: #71717a;
                                    }
                                }
                            }
                        }

                        // Gemini Models Quota Card
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Gemini Quota Pool"; font-size: 13px; font-weight: 700; color: #ffffff; }
                                        Text { text: "Dedicated capacity for Gemini 2.5 Flash, 2.5 Pro, and Gemini 3.x models"; font-size: 11px; color: #71717a; }
                                    }
                                    Badge {
                                        text: "Resets " + root.global_gemini_reset;
                                        is_green: root.global_gemini_percent > 20;
                                        is_danger: root.global_gemini_percent <= 20;
                                    }
                                }

                                // Progress Bar Container
                                Rectangle {
                                    height: 8px;
                                    border-radius: 4px;
                                    background: #27272a;

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 8px;
                                        border-radius: 4px;
                                        width: parent.width * (root.global_gemini_percent / 100.0);
                                        background: root.global_gemini_percent < 20 ? #ef4444 : (root.global_gemini_percent < 50 ? #fbbf24 : #4ade80);
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: root.global_gemini_percent + "% Available Capacity";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: root.global_gemini_percent < 20 ? #f87171 : (root.global_gemini_percent < 50 ? #fbbf24 : #4ade80);
                                    }
                                    Text {
                                        text: "Multi-Turn Optimized";
                                        font-size: 11px;
                                        color: #71717a;
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 1: ACCOUNTS & QUOTAS
                    // ==========================================
                    if root.active_tab == 1: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        // Top Connect Actions Box (Clean single token input, no manual account name!)
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Add Antigravity Account"; font-size: 13px; font-weight: 700; color: #ffffff; }
                                        Text { text: "Authorize via browser OAuth or paste Session / Refresh Token (email & quota are auto-parsed)"; font-size: 11px; color: #71717a; }
                                    }
                                    ActionButton {
                                        text: "Login via Browser (OAuth)";
                                        is_accent: true;
                                        clicked => { root.add_account_browser_oauth(); }
                                    }
                                }

                                // Single Token Input Form
                                HorizontalLayout {
                                    spacing: 10px;
                                    LineEdit {
                                        placeholder-text: "Paste Refresh Token / OAuth Session Key (ya29... or 1//...)";
                                        text <=> root.new_acc_token;
                                        horizontal-stretch: 1;
                                    }
                                    ActionButton {
                                        text: "Add Token";
                                        is_primary: true;
                                        clicked => { root.add_account(); }
                                    }
                                }
                            }
                        }

                        // Info Modal Drawer (if active)
                        if root.show_account_info: Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #3f3f46;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Account Details: " + root.info_account_name; font-size: 13px; font-weight: 700; color: #ffffff; }
                                    ActionButton {
                                        text: "Close";
                                        is_primary: false;
                                        clicked => { root.show_account_info = false; }
                                    }
                                }

                                Text { text: "Subscription Tier: " + root.info_account_tier; font-size: 12px; color: #a1a1aa; }
                                Text { text: "Quota Status: " + root.info_account_quota; font-size: 12px; color: #a1a1aa; }
                                Text { text: "Active Models: " + root.info_account_models; font-size: 12px; color: #a1a1aa; }
                            }
                        }

                        // Accounts List Header
                        Text { text: "CONNECTED ACCOUNTS (POOL)"; font-size: 11px; font-weight: 700; color: #71717a; }

                        // Account Cards (Only Update, Info, Delete - No Set Active!)
                        for acc in root.accounts: Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text { text: acc.name; font-size: 13px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Badge {
                                            text: acc.tier;
                                            is_green: acc.tier == "PRO" || acc.tier == "Pro";
                                        }
                                        Badge {
                                            text: acc.status;
                                            is_green: acc.status == "Active";
                                            is_danger: acc.status != "Active";
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        ActionButton {
                                            text: "Update";
                                            is_primary: false;
                                            clicked => { root.refresh_account_quota(acc.id); }
                                        }
                                        ActionButton {
                                            text: "Info";
                                            is_primary: false;
                                            clicked => { root.show_account_details(acc.id); }
                                        }
                                        ActionButton {
                                            text: "Delete";
                                            is_danger: true;
                                            clicked => { root.delete_account(acc.id); }
                                        }
                                    }
                                }

                                // Claude & GPT Quota Bar
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Claude & GPT: " + acc.claude_gpt_percent + "% Available";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: acc.claude_gpt_percent < 20 ? #f87171 : (acc.claude_gpt_percent < 50 ? #fbbf24 : #4ade80);
                                    }
                                    Text {
                                        text: "Resets " + acc.claude_gpt_reset;
                                        font-size: 10px;
                                        color: #71717a;
                                    }
                                }
                                Rectangle {
                                    height: 5px;
                                    border-radius: 3px;
                                    background: #27272a;

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 5px;
                                        border-radius: 3px;
                                        width: parent.width * (acc.claude_gpt_percent / 100.0);
                                        background: acc.claude_gpt_percent < 20 ? #ef4444 : (acc.claude_gpt_percent < 50 ? #fbbf24 : #4ade80);
                                    }
                                }

                                // Gemini Quota Bar
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Gemini: " + acc.gemini_percent + "% Available";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: acc.gemini_percent < 20 ? #f87171 : (acc.gemini_percent < 50 ? #fbbf24 : #4ade80);
                                    }
                                    Text {
                                        text: "Resets " + acc.gemini_reset;
                                        font-size: 10px;
                                        color: #71717a;
                                    }
                                }
                                Rectangle {
                                    height: 5px;
                                    border-radius: 3px;
                                    background: #27272a;

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 5px;
                                        border-radius: 3px;
                                        width: parent.width * (acc.gemini_percent / 100.0);
                                        background: acc.gemini_percent < 20 ? #ef4444 : (acc.gemini_percent < 50 ? #fbbf24 : #4ade80);
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 2: MODELS & TEST PLAYGROUND
                    // ==========================================
                    if root.active_tab == 2: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        // Master Toggle for Reasoning Effort Clones
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Expose Reasoning Effort Clones in /v1/models"; font-size: 13px; font-weight: 700; color: #ffffff; }
                                        Text { text: "Generates virtual aliases (low), (medium), (high) for clients without native reasoning controls"; font-size: 11px; color: #71717a; }
                                    }
                                    ToggleSwitch {
                                        checked: root.expose_reasoning_variants;
                                        toggled => { root.toggle_reasoning_variants(); }
                                    }
                                }
                            }
                        }

                        // Test Request / Model Playground
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Model Playground & Debug Inspector"; font-size: 13px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Badge { text: root.playground_model; }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text { text: "Status: " + root.playground_status + " | " + root.playground_latency + " | " + root.playground_tokens + " tok"; font-size: 11px; color: #a1a1aa; vertical-alignment: center; }
                                        ActionButton {
                                            text: root.playground_running ? "Sending..." : "Send Test Request";
                                            is_accent: true;
                                            clicked => { root.run_playground_test(); }
                                        }
                                    }
                                }

                                LineEdit {
                                    text <=> root.playground_prompt;
                                    placeholder-text: "Enter a test prompt to send through the active Aroxy proxy...";
                                }

                                Rectangle {
                                    height: 110px;
                                    border-radius: 6px;
                                    background: #111113;
                                    border-width: 1px;
                                    border-color: #27272a;

                                    VerticalLayout {
                                        padding: 10px;
                                        Text {
                                            text: root.playground_response == "" ? "Response output, streaming debug telemetry, and headers will appear here..." : root.playground_response;
                                            font-size: 12px;
                                            color: root.playground_response == "" ? #52525b : #e4e4e7;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }

                        Text { text: "CATALOG MODELS & BROADCAST PERMISSIONS"; font-size: 11px; font-weight: 700; color: #71717a; }

                        // Models Table
                        for model in root.models: Rectangle {
                            height: 44px;
                            background: #18181b;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #27272a;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Text { text: model.display_name; font-size: 13px; font-weight: 600; color: #ffffff; vertical-alignment: center; }
                                    Badge { text: model.id; }
                                    Badge { text: model.tier; is_green: model.tier == "PRO" || model.tier == "Pro"; }
                                    if model.supports_thinking: Badge { text: "Thinking"; is_amber: true; }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: end;
                                    ActionButton {
                                        text: "Test in Playground";
                                        is_primary: false;
                                        clicked => {
                                            root.playground_model = model.id;
                                            root.active_model = model.id;
                                        }
                                    }
                                    ToggleSwitch {
                                        checked: model.is_enabled;
                                        toggled => { root.toggle_model(model.id); }
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 3: PROXY LAYER ("Прослойка")
                    // ==========================================
                    if root.active_tab == 3: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        // Routing Strategy Box
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: "Multi-Account Routing Strategy"; font-size: 13px; font-weight: 700; color: #ffffff; }

                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton {
                                        text: "Quota-Aware (Smart)";
                                        is_primary: root.routing_strategy_index == 0;
                                        is_accent: root.routing_strategy_index == 0;
                                        clicked => { root.set_routing_strategy(0); }
                                    }
                                    ActionButton {
                                        text: "Round-Robin";
                                        is_primary: root.routing_strategy_index == 1;
                                        is_accent: root.routing_strategy_index == 1;
                                        clicked => { root.set_routing_strategy(1); }
                                    }
                                    ActionButton {
                                        text: "Failover / Priority";
                                        is_primary: root.routing_strategy_index == 2;
                                        is_accent: root.routing_strategy_index == 2;
                                        clicked => { root.set_routing_strategy(2); }
                                    }
                                }

                                Text {
                                    text: root.routing_strategy_index == 0
                                        ? "• Quota-Aware: Dispatches each incoming request to the healthy account with the highest remaining quota percentage."
                                        : (root.routing_strategy_index == 1
                                            ? "• Round-Robin: Evenly distributes traffic sequentially across all active connected accounts."
                                            : "• Failover: Routes solely to the primary account, automatically falling back to secondary on rate-limit (429).");
                                    font-size: 11px;
                                    color: #a1a1aa;
                                }
                            }
                        }

                        // Cache Affinity & Balancer Aggressiveness Box
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Prompt Cache Affinity & Balancing Aggressiveness"; font-size: 13px; font-weight: 700; color: #ffffff; }
                                        Text { text: "Controls how hard Aroxy pins sessions to accounts for 100k+ token KV cache hits vs aggressive quota distribution"; font-size: 11px; color: #71717a; }
                                    }
                                    Badge {
                                        text: "Hit Rate: " + root.balancer_hit_rate;
                                        is_green: true;
                                    }
                                }

                                // 3 Balancer Modes
                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton {
                                        text: "Cache-First (Max Speed)";
                                        is_primary: root.cache_affinity_mode_index == 0;
                                        is_accent: root.cache_affinity_mode_index == 0;
                                        clicked => { root.set_cache_affinity_mode(0); }
                                    }
                                    ActionButton {
                                        text: "Balanced (Smart Hybrid)";
                                        is_primary: root.cache_affinity_mode_index == 1;
                                        is_accent: root.cache_affinity_mode_index == 1;
                                        clicked => { root.set_cache_affinity_mode(1); }
                                    }
                                    ActionButton {
                                        text: "Aggressive Spread (Leveling)";
                                        is_primary: root.cache_affinity_mode_index == 2;
                                        is_accent: root.cache_affinity_mode_index == 2;
                                        clicked => { root.set_cache_affinity_mode(2); }
                                    }
                                }

                                Text {
                                    text: root.cache_affinity_mode_index == 0
                                        ? "• Cache-First: Maximizes upstream KV Prompt Caching (95%+ hit rate, 10x faster TTFT). Keeps conversation thread strictly pinned to the same account until rate-limited (429) or depleted."
                                        : (root.cache_affinity_mode_index == 1
                                            ? "• Balanced: Pins conversation to preserve prompt caching, but smoothly rotates if another account has > " + root.quota_imbalance_threshold + "% more quota to prevent pool starvation."
                                            : "• Aggressive Spread: Rotates across all healthy accounts on every single request, completely disregarding prompt cache for maximum uniform quota consumption.");
                                    font-size: 11px;
                                    color: #a1a1aa;
                                }

                                // Fine Tuning Parameters Row
                                HorizontalLayout {
                                    spacing: 12px;

                                    // Sticky TTL Box
                                    Rectangle {
                                        border-radius: 6px;
                                        background: #121214;
                                        border-width: 1px;
                                        border-color: #27272a;
                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 6px;
                                            Text { text: "SESSION PIN DURATION (TTL)"; font-size: 10px; font-weight: 700; color: #71717a; }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                ActionButton {
                                                    text: "5m";
                                                    is_primary: root.session_sticky_ttl_secs == 300;
                                                    is_accent: root.session_sticky_ttl_secs == 300;
                                                    clicked => { root.set_session_ttl(300); }
                                                }
                                                ActionButton {
                                                    text: "15m";
                                                    is_primary: root.session_sticky_ttl_secs == 900;
                                                    is_accent: root.session_sticky_ttl_secs == 900;
                                                    clicked => { root.set_session_ttl(900); }
                                                }
                                                ActionButton {
                                                    text: "30m";
                                                    is_primary: root.session_sticky_ttl_secs == 1800;
                                                    is_accent: root.session_sticky_ttl_secs == 1800;
                                                    clicked => { root.set_session_ttl(1800); }
                                                }
                                                ActionButton {
                                                    text: "60m";
                                                    is_primary: root.session_sticky_ttl_secs == 3600;
                                                    is_accent: root.session_sticky_ttl_secs == 3600;
                                                    clicked => { root.set_session_ttl(3600); }
                                                }
                                            }
                                        }
                                    }

                                    // Quota Imbalance Threshold Box
                                    Rectangle {
                                        border-radius: 6px;
                                        background: #121214;
                                        border-width: 1px;
                                        border-color: #27272a;
                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 6px;
                                            Text { text: "ROTATION IMBALANCE SENSITIVITY"; font-size: 10px; font-weight: 700; color: #71717a; }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                ActionButton {
                                                    text: "15% (Eager)";
                                                    is_primary: root.quota_imbalance_threshold == 15;
                                                    is_accent: root.quota_imbalance_threshold == 15;
                                                    clicked => { root.set_imbalance_threshold(15); }
                                                }
                                                ActionButton {
                                                    text: "25% (Optimal)";
                                                    is_primary: root.quota_imbalance_threshold == 25;
                                                    is_accent: root.quota_imbalance_threshold == 25;
                                                    clicked => { root.set_imbalance_threshold(25); }
                                                }
                                                ActionButton {
                                                    text: "40% (Sticky)";
                                                    is_primary: root.quota_imbalance_threshold == 40;
                                                    is_accent: root.quota_imbalance_threshold == 40;
                                                    clicked => { root.set_imbalance_threshold(40); }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Zero-Downtime 429 Failover Toggle
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Seamless Zero-Downtime 429 Failover"; font-size: 12px; font-weight: 600; color: #fafafa; }
                                        Text { text: "Instantly and silently retries request on next healthy account when an upstream account hits rate limits"; font-size: 11px; color: #71717a; }
                                    }
                                    ToggleSwitch {
                                        checked: root.failover_on_429;
                                        toggled => { root.toggle_failover_429(); }
                                    }
                                }
                            }
                        }

                        // Balancer Live Stat Cards
                        HorizontalLayout {
                            spacing: 12px;
                            StatCard {
                                title: "CACHE AFFINITY HIT RATE";
                                value: root.balancer_hit_rate;
                                subtext: "Prompt caching continuity";
                            }
                            StatCard {
                                title: "PINNED THREADS";
                                value: root.balancer_active_sessions + "";
                                subtext: "Active conversational sessions";
                            }
                            StatCard {
                                title: "AUTOMATIC FAILOVERS";
                                value: root.balancer_failover_count + "";
                                subtext: "Seamless 429 rotations";
                            }
                        }

                        // Network Binding & Protocol Endpoints
                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: "Active Protocol Endpoints & Service State"; font-size: 13px; font-weight: 700; color: #ffffff; }

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text { text: "PROTOCOL"; width: 120px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "ENDPOINT PATH"; horizontal-stretch: 1; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "STATUS"; width: 90px; font-size: 10px; font-weight: 700; color: #71717a; }
                                }

                                Rectangle {
                                    height: 34px;
                                    border-radius: 6px;
                                    background: #121214;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text { text: "OpenAI v1"; width: 120px; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "http://" + root.proxy_host + ":" + root.proxy_port + "/v1/chat/completions"; horizontal-stretch: 1; font-size: 12px; color: #a1a1aa; vertical-alignment: center; }
                                        Badge { text: root.proxy_running ? "ONLINE" : "OFFLINE"; is_green: root.proxy_running; }
                                    }
                                }

                                Rectangle {
                                    height: 34px;
                                    border-radius: 6px;
                                    background: #121214;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text { text: "Claude Messages"; width: 120px; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "http://" + root.proxy_host + ":" + root.proxy_port + "/v1/messages"; horizontal-stretch: 1; font-size: 12px; color: #a1a1aa; vertical-alignment: center; }
                                        Badge { text: root.proxy_running ? "ONLINE" : "OFFLINE"; is_green: root.proxy_running; }
                                    }
                                }

                                Rectangle {
                                    height: 34px;
                                    border-radius: 6px;
                                    background: #121214;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text { text: "Model Catalog"; width: 120px; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "http://" + root.proxy_host + ":" + root.proxy_port + "/v1/models"; horizontal-stretch: 1; font-size: 12px; color: #a1a1aa; vertical-alignment: center; }
                                        Badge { text: root.proxy_running ? "ONLINE" : "OFFLINE"; is_green: root.proxy_running; }
                                    }
                                }

                                Rectangle {
                                    height: 34px;
                                    border-radius: 6px;
                                    background: #121214;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text { text: "Browser OAuth"; width: 120px; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "http://" + root.proxy_host + ":" + root.proxy_port + "/oauth/callback"; horizontal-stretch: 1; font-size: 12px; color: #a1a1aa; vertical-alignment: center; }
                                        Badge { text: root.proxy_running ? "ONLINE" : "OFFLINE"; is_green: root.proxy_running; }
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 4: TRAFFIC LOGS
                    // ==========================================
                    if root.active_tab == 4: VerticalLayout {
                        alignment: start;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "RECENT TRAFFIC LOGS (STREAM & BATCH)"; font-size: 11px; font-weight: 700; color: #71717a; vertical-alignment: center; }
                            ActionButton {
                                text: "Clear Logs";
                                is_primary: false;
                                clicked => { root.clear_logs(); }
                            }
                        }

                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;

                                // Responsive Table Header
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text { text: "TIME"; width: 70px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "METHOD"; width: 60px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "ENDPOINT"; horizontal-stretch: 1; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "MODEL"; width: 150px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "STATUS"; width: 65px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "TOKENS"; width: 60px; font-size: 10px; font-weight: 700; color: #71717a; }
                                    Text { text: "LATENCY"; width: 65px; font-size: 10px; font-weight: 700; color: #71717a; }
                                }

                                // Table Rows
                                for log in root.log_entries: Rectangle {
                                    height: 32px;
                                    border-radius: 6px;
                                    background: #121214;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text { text: log.time; width: 70px; font-size: 11px; color: #71717a; vertical-alignment: center; }
                                        Text { text: log.method; width: 60px; font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: log.path; horizontal-stretch: 1; font-size: 11px; color: #d4d4d8; vertical-alignment: center; }
                                        Text { text: log.model; width: 150px; font-size: 11px; color: #a1a1aa; vertical-alignment: center; }
                                        Text {
                                            text: log.status == 200 ? "200 OK" : (log.status + "");
                                            width: 65px;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: log.status == 200 ? #4ade80 : #f87171;
                                            vertical-alignment: center;
                                        }
                                        Text { text: log.tokens + ""; width: 60px; font-size: 11px; color: #a1a1aa; vertical-alignment: center; }
                                        Text { text: log.latency_ms + "ms"; width: 65px; font-size: 11px; color: #71717a; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 5: STATISTICS
                    // ==========================================
                    if root.active_tab == 5: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        // Token Distribution Cards
                        Text { text: "TOKEN VOLUME BREAKDOWN"; font-size: 11px; font-weight: 700; color: #71717a; }

                        HorizontalLayout {
                            spacing: 12px;
                            StatCard {
                                title: "PROMPT TOKENS";
                                value: root.stat_prompt_tokens;
                                subtext: "Context & instructions sent";
                            }
                            StatCard {
                                title: "OUTPUT TOKENS";
                                value: root.stat_completion_tokens;
                                subtext: "Standard completion tokens";
                            }
                            StatCard {
                                title: "THINKING TOKENS";
                                value: root.stat_thinking_tokens;
                                subtext: "Reasoning budget processed";
                            }
                        }

                        // Quality of Service & Latency Percentiles
                        Text { text: "QUALITY OF SERVICE & PERFORMANCE"; font-size: 11px; font-weight: 700; color: #71717a; }

                        HorizontalLayout {
                            spacing: 12px;
                            StatCard {
                                title: "SUCCESS RATE";
                                value: root.stat_success_rate;
                                subtext: "HTTP 2xx completion ratio";
                            }
                            StatCard {
                                title: "TOTAL ERRORS / 429";
                                value: root.stat_error_count;
                                subtext: "Rate limit / upstream retries";
                            }
                            StatCard {
                                title: "MAX RECORDED LATENCY";
                                value: root.stat_max_latency;
                                subtext: "Peak stream wait time";
                            }
                        }
                    }

                    // ==========================================
                    // TAB 6: SETTINGS
                    // ==========================================
                    if root.active_tab == 6: VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                Text { text: "System & Window Preferences"; font-size: 13px; font-weight: 700; color: #ffffff; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Minimize to System Tray on Close"; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Keeps the proxy daemon serving API requests silently in the background"; font-size: 11px; color: #71717a; }
                                    }
                                    ToggleSwitch {
                                        checked: root.setting_minimize_tray;
                                        toggled => { root.setting_minimize_tray = !root.setting_minimize_tray; }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Portable Configuration Mode"; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Store configuration in aroxy.json next to binary instead of OS AppData"; font-size: 11px; color: #71717a; }
                                    }
                                    ToggleSwitch {
                                        checked: root.setting_portable_mode;
                                        toggled => { root.setting_portable_mode = !root.setting_portable_mode; }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Start Minimized with Operating System"; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Launches Aroxy daemon on user login"; font-size: 11px; color: #71717a; }
                                    }
                                    ToggleSwitch {
                                        checked: root.setting_autostart;
                                        toggled => { root.setting_autostart = !root.setting_autostart; }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            background: #18181b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272a;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                Text { text: "Protocol & Timeout Tuning"; font-size: 13px; font-weight: 700; color: #ffffff; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "SSE Keepalive / Heartbeat Interval: " + root.setting_heartbeat_secs + "s"; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Sends ': ping' frames during long thinking steps to avoid client disconnection"; font-size: 11px; color: #71717a; }
                                    }
                                    ActionButton {
                                        text: "12s (Default)";
                                        is_primary: true;
                                        clicked => { root.setting_heartbeat_secs = 12; }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Upstream Request Timeout: " + root.setting_timeout_secs + "s"; font-size: 12px; color: #e4e4e7; }
                                        Text { text: "Maximum wait duration before returning 504 Gateway Timeout"; font-size: 11px; color: #71717a; }
                                    }
                                    ActionButton {
                                        text: "120s (Default)";
                                        is_primary: true;
                                        clicked => { root.setting_timeout_secs = 120; }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 10px;
                                    ActionButton {
                                        text: "Save & Apply Settings";
                                        is_accent: true;
                                        clicked => { root.save_settings(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
