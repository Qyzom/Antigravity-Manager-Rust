export struct LogEntryData {
    id: string,
    time: string,
    method: string,
    path: string,
    model: string,
    status: int,
    tokens: int,
    latency_ms: int,
}

export struct AccountData {
    id: string,
    name: string,
    provider: string,
    base_url: string,
    api_key_masked: string,
    fingerprint: string,
    is_active: bool,
}

export struct ModelItemData {
    id: string,
    display_name: string,
    provider: string,
    is_enabled: bool,
    supports_thinking: bool,
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon_symbol: "•";
    in property <bool> is_active: false;
    callback clicked;

    height: 40px;
    border-radius: 9px;
    background: root.is_active ? #353742 : (touch.has-hover ? #24252d : transparent);
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        alignment: start;

        Text {
            text: root.icon_symbol;
            font-size: 14px;
            font-weight: 700;
            color: root.is_active ? #ffffff : (touch.has-hover ? #d2d5e2 : #868b9c);
            vertical-alignment: center;
        }

        Text {
            text: root.text;
            font-size: 13px;
            font-weight: root.is_active ? 700 : 500;
            color: root.is_active ? #ffffff : (touch.has-hover ? #e4e7f2 : #969ba8);
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> is_primary: true;
    in property <bool> is_danger: false;
    callback clicked;

    height: 34px;
    border-radius: 8px;
    background: root.is_danger 
        ? (touch.pressed ? #a82e2e : (touch.has-hover ? #d93838 : #8a2424))
        : (root.is_primary 
            ? (touch.pressed ? #e0e0e0 : (touch.has-hover ? #ffffff : #f2f2f2))
            : (touch.pressed ? #191b22 : (touch.has-hover ? #31333d : #23252e)));
    border-width: root.is_primary ? 0px : 1px;
    border-color: #383b48;
    animate background { duration: 100ms; }

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        font-size: 12px;
        font-weight: 700;
        color: root.is_danger ? #ffffff : (root.is_primary ? #121318 : #e0e3ed);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ToggleSwitch inherits Rectangle {
    in property <bool> checked: false;
    callback toggled;

    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? #38d39f : #292b34;
    animate background { duration: 120ms; }

    Rectangle {
        x: root.checked ? 22px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        animate x { duration: 120ms; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

component StatCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> subtext;

    border-radius: 10px;
    background: #1a1b22;
    border-width: 1px;
    border-color: #272934;

    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        Text {
            text: root.title;
            font-size: 10px;
            font-weight: 700;
            color: #797f94;
            letter-spacing: 0.5px;
        }
        Text {
            text: root.value;
            font-size: 20px;
            font-weight: 800;
            color: #ffffff;
        }
        Text {
            text: root.subtext;
            font-size: 10px;
            color: #9ea4b8;
        }
    }
}

export component MainWindow inherits Window {
    title: "Aroxy — Minimalist AI Protocol Proxy";
    min-width: 860px;
    min-height: 580px;
    preferred-width: 940px;
    preferred-height: 640px;
    background: #111217;

    in-out property <int> active_tab: 0;
    in-out property <bool> proxy_running: false;
    in-out property <int> proxy_port: 8045;
    in-out property <string> active_model: "claude-3-7-sonnet";
    in-out property <string> total_requests: "0";
    in-out property <string> total_tokens: "0";
    in-out property <string> avg_latency: "0 ms";
    in-out property <bool> expose_reasoning_variants: true;

    in-out property <[LogEntryData]> log_entries: [];
    in-out property <[AccountData]> accounts: [];
    in-out property <[ModelItemData]> models: [];

    in-out property <string> new_acc_name: "";
    in-out property <string> new_acc_key: "";
    in-out property <string> new_acc_url: "https://api.anthropic.com";
    in-out property <string> new_acc_fp: "Claude Code 2.x";

    callback toggle_proxy();
    callback clear_logs();
    callback add_account();
    callback delete_account(string);
    callback activate_account(string);
    callback toggle_model(string);
    callback toggle_reasoning_variants();

    HorizontalLayout {
        // Modern Dark Sidebar (QPatcher Style)
        Rectangle {
            width: 200px;
            background: #17181e;

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                // Application Title
                HorizontalLayout {
                    padding-bottom: 8px;
                    padding-left: 6px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Aroxy";
                        font-size: 16px;
                        font-weight: 800;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "v0.0.1";
                        font-size: 11px;
                        font-weight: 600;
                        color: #6a6f80;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 6px; }

                // Navigation Items
                NavItem {
                    text: "Overview";
                    icon_symbol: "▤";
                    is_active: root.active_tab == 0;
                    clicked => { root.active_tab = 0; }
                }
                NavItem {
                    text: "Model Catalog";
                    icon_symbol: "⊞";
                    is_active: root.active_tab == 1;
                    clicked => { root.active_tab = 1; }
                }
                NavItem {
                    text: "Accounts & FP";
                    icon_symbol: "⚙";
                    is_active: root.active_tab == 2;
                    clicked => { root.active_tab = 2; }
                }
                NavItem {
                    text: "Traffic Logs";
                    icon_symbol: "☰";
                    is_active: root.active_tab == 3;
                    clicked => { root.active_tab = 3; }
                }
                NavItem {
                    text: "Settings";
                    icon_symbol: "❖";
                    is_active: root.active_tab == 4;
                    clicked => { root.active_tab = 4; }
                }

                // Spacer
                Rectangle { }

                // Status Badge in Sidebar
                Rectangle {
                    height: 38px;
                    border-radius: 8px;
                    background: root.proxy_running ? #162a21 : #261919;
                    border-width: 1px;
                    border-color: root.proxy_running ? #24563d : #592525;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: center;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: root.proxy_running ? #38d39f : #f05454;
                        }
                        Text {
                            text: root.proxy_running ? "RUNNING :8045" : "OFFLINE";
                            font-size: 11px;
                            font-weight: 700;
                            color: root.proxy_running ? #38d39f : #f05454;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Main Content Area
        VerticalLayout {
            padding: 24px;
            spacing: 20px;

            // Top Header Bar
            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: root.active_tab == 0 ? "Dashboard & Status"
                            : root.active_tab == 1 ? "Broadcasted Models & Reasoning"
                            : root.active_tab == 2 ? "Upstream Providers & Signatures"
                            : root.active_tab == 3 ? "Real-time Traffic & Stream Inspector"
                            : "Preferences & System";
                        font-size: 20px;
                        font-weight: 800;
                        color: #ffffff;
                    }
                    Text {
                        text: root.active_tab == 0 ? "Local OpenAI v1 / Claude / Gemini endpoint emulator"
                            : root.active_tab == 1 ? "Configure which models to broadcast and toggle reasoning effort clones"
                            : root.active_tab == 2 ? "Manage provider credentials and client anti-detection fingerprints"
                            : root.active_tab == 3 ? "Lock-free streaming metrics, tokens, and response latencies"
                            : "Tray daemon, autostart, and local network ports";
                        font-size: 12px;
                        color: #797f94;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    ActionButton {
                        text: root.proxy_running ? "STOP PROXY" : "START PROXY";
                        is_primary: !root.proxy_running;
                        is_danger: root.proxy_running;
                        clicked => { root.toggle_proxy(); }
                    }
                }
            }

            // Tab 0: Overview
            if root.active_tab == 0: VerticalLayout {
                spacing: 16px;

                HorizontalLayout {
                    spacing: 14px;
                    StatCard {
                        title: "TOTAL REQUESTS";
                        value: root.total_requests;
                        subtext: "All incoming API calls";
                    }
                    StatCard {
                        title: "PROCESSED TOKENS";
                        value: root.total_tokens;
                        subtext: "Prompt + Output + Thinking";
                    }
                    StatCard {
                        title: "AVG LATENCY";
                        value: root.avg_latency;
                        subtext: "Time to first token (TTFT)";
                    }
                    StatCard {
                        title: "LOCAL ENDPOINT";
                        value: "127.0.0.1:" + root.proxy_port;
                        subtext: "/v1/chat/completions";
                    }
                }

                Rectangle {
                    background: #181920;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #272834;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 14px;
                        Text {
                            text: "Active Route & Compatible Clients";
                            font-size: 14px;
                            font-weight: 700;
                            color: #ffffff;
                        }
                        Text {
                            text: "Point your AI client (Claude Code, Cursor, OpenCode, Aider, LibreChat) to:";
                            font-size: 12px;
                            color: #9ea4b8;
                        }
                        Rectangle {
                            height: 38px;
                            border-radius: 8px;
                            background: #0f1015;
                            border-width: 1px;
                            border-color: #2b2f3f;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: space-between;
                                Text {
                                    text: "http://127.0.0.1:8045/v1";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "OpenAI v1 / Claude / Gemini compliant";
                                    font-size: 11px;
                                    color: #5c6277;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Rectangle {
                                border-radius: 8px;
                                background: #20222b;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 4px;
                                    Text { text: "Claude Code CLI"; font-size: 12px; font-weight: 700; color: #ffffff; }
                                    Text { text: "ANTHROPIC_BASE_URL=http://localhost:8045"; font-size: 11px; color: #8a90a4; }
                                }
                            }
                            Rectangle {
                                border-radius: 8px;
                                background: #20222b;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 4px;
                                    Text { text: "OpenAI / Cursor / Aider"; font-size: 12px; font-weight: 700; color: #ffffff; }
                                    Text { text: "OPENAI_BASE_URL=http://localhost:8045/v1"; font-size: 11px; color: #8a90a4; }
                                }
                            }
                        }
                    }
                }
            }

            // Tab 1: Model Catalog (New!)
            if root.active_tab == 1: VerticalLayout {
                spacing: 14px;

                // Master Toggle for Reasoning Effort Clones
                Rectangle {
                    background: #181920;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #272834;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "Expose Reasoning Effort Clones in /v1/models";
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: #ffffff;
                                }
                                Text {
                                    text: "Dynamically creates (low), (medium), (high) model aliases so clients without reasoning sliders can select effort levels.";
                                    font-size: 11px;
                                    color: #8b90a4;
                                }
                            }
                            ToggleSwitch {
                                checked: root.expose_reasoning_variants;
                                toggled => { root.toggle_reasoning_variants(); }
                            }
                        }
                    }
                }

                // Models List
                Rectangle {
                    background: #181920;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #272834;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: "Available Models";
                            font-size: 13px;
                            font-weight: 700;
                            color: #797f94;
                        }

                        for m in root.models: Rectangle {
                            height: 44px;
                            border-radius: 8px;
                            background: m.is_enabled ? #20232d : #14151a;
                            border-width: 1px;
                            border-color: m.is_enabled ? #353b4c : #20222a;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: center;
                                    Text {
                                        text: m.display_name;
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: m.is_enabled ? #ffffff : #6f7485;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: m.id;
                                        font-size: 11px;
                                        color: #72788e;
                                        vertical-alignment: center;
                                    }
                                    if m.supports_thinking: Rectangle {
                                        height: 20px;
                                        border-radius: 4px;
                                        background: #2a382e;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text {
                                                text: "REASONING";
                                                font-size: 9px;
                                                font-weight: 800;
                                                color: #38d39f;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    ToggleSwitch {
                                        checked: m.is_enabled;
                                        toggled => { root.toggle_model(m.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Tab 2: Accounts & Fingerprints
            if root.active_tab == 2: VerticalLayout {
                spacing: 14px;

                Rectangle {
                    background: #181920;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #272834;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text {
                            text: "Add Upstream Provider";
                            font-size: 14px;
                            font-weight: 700;
                            color: #ffffff;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            TextInput {
                                text <=> root.new_acc_name;
                                font-size: 12px;
                                color: #ffffff;
                                width: 140px;
                            }
                            TextInput {
                                text <=> root.new_acc_url;
                                font-size: 12px;
                                color: #ffffff;
                                width: 220px;
                            }
                            TextInput {
                                text <=> root.new_acc_key;
                                font-size: 12px;
                                color: #ffffff;
                                width: 180px;
                            }
                            ActionButton {
                                text: "+ Add";
                                is_primary: true;
                                clicked => { root.add_account(); }
                            }
                        }
                    }
                }

                // Accounts List
                Rectangle {
                    background: #181920;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #272834;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: "Configured Accounts";
                            font-size: 13px;
                            font-weight: 700;
                            color: #797f94;
                        }

                        for acc in root.accounts: Rectangle {
                            height: 48px;
                            border-radius: 8px;
                            background: acc.is_active ? #212635 : #14151a;
                            border-width: 1px;
                            border-color: acc.is_active ? #3c4a6b : #20222a;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: center;
                                    Text {
                                        text: acc.name;
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: acc.base_url;
                                        font-size: 11px;
                                        color: #72788e;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "FP: " + acc.fingerprint;
                                        font-size: 10px;
                                        color: #636b85;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;
                                    if !acc.is_active: ActionButton {
                                        text: "Set Active";
                                        is_primary: false;
                                        clicked => { root.activate_account(acc.id); }
                                    }
                                    ActionButton {
                                        text: "Delete";
                                        is_primary: false;
                                        is_danger: true;
                                        clicked => { root.delete_account(acc.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Tab 3: Logs
            if root.active_tab == 3: VerticalLayout {
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Recent Traffic (Last 100 requests)";
                        font-size: 13px;
                        font-weight: 700;
                        color: #797f94;
                        vertical-alignment: center;
                    }
                    ActionButton {
                        text: "Clear Logs";
                        is_primary: false;
                        clicked => { root.clear_logs(); }
                    }
                }

                Rectangle {
                    background: #181920;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #272834;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;

                        // Table Header
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text { text: "TIME"; width: 80px; font-size: 10px; font-weight: 700; color: #52576b; }
                            Text { text: "METHOD"; width: 70px; font-size: 10px; font-weight: 700; color: #52576b; }
                            Text { text: "ENDPOINT"; width: 180px; font-size: 10px; font-weight: 700; color: #52576b; }
                            Text { text: "MODEL"; width: 160px; font-size: 10px; font-weight: 700; color: #52576b; }
                            Text { text: "STATUS"; width: 70px; font-size: 10px; font-weight: 700; color: #52576b; }
                            Text { text: "TOKENS"; width: 70px; font-size: 10px; font-weight: 700; color: #52576b; }
                            Text { text: "LATENCY"; width: 70px; font-size: 10px; font-weight: 700; color: #52576b; }
                        }

                        // Table Rows
                        for log in root.log_entries: Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: #121318;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text { text: log.time; width: 80px; font-size: 11px; color: #72788e; vertical-alignment: center; }
                                Text { text: log.method; width: 70px; font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                Text { text: log.path; width: 180px; font-size: 11px; color: #c4c7d5; vertical-alignment: center; }
                                Text { text: log.model; width: 160px; font-size: 11px; color: #8e95ad; vertical-alignment: center; }
                                Text {
                                    text: log.status == 200 ? "200 OK" : (log.status + "");
                                    width: 70px;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: log.status == 200 ? #38d39f : #f05454;
                                    vertical-alignment: center;
                                }
                                Text { text: log.tokens + ""; width: 70px; font-size: 11px; color: #9ea4b8; vertical-alignment: center; }
                                Text { text: log.latency_ms + "ms"; width: 70px; font-size: 11px; color: #72788e; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }

            // Tab 4: Settings
            if root.active_tab == 4: VerticalLayout {
                spacing: 14px;
                Rectangle {
                    background: #181920;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #272834;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Text { text: "System & Network Preferences (Aroxy v0.0.1)"; font-size: 14px; font-weight: 700; color: #ffffff; }
                        Text { text: "• System Tray Daemon: Run silently in background without closing server."; font-size: 12px; color: #9ea4b8; }
                        Text { text: "• Portable Config: Saves config next to binary in aroxy.json."; font-size: 12px; color: #9ea4b8; }
                        Text { text: "• Zero Telemetry: Completely offline, no phone-home, no trackers, no ads."; font-size: 12px; color: #9ea4b8; }
                    }
                }
            }
        }
    }
}
